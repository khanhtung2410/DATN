@model Cuahangchamsocthucung.Web.Models.NhanVien.NhanVienListViewModel
@using Cuahangchamsocthucung.Enum
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Danh sách nhân viên";
    ViewBag.CurrentPageName = "Nhân viên";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Nhân viên</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="javascript:;" data-toggle="modal" data-target="#NhanVienCreateModal" class="btn bg-blue">
                    <i class="fa fa-plus-square"></i> Thêm
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="NhanVienTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Họ và tên</th>
                                        <th>Số điện thoại</th>
                                        <th>Ngày vào làm</th>
                                        <th>Trạng thái</th>
                                        <th style="width: 180px">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.NhanViens != null)
                                    {
                                        foreach (var item in Model.NhanViens)
                                        {
                                            <tr>
                                                <td></td>
                                                <td>@item.Hoten</td>
                                                <td>@item.SDT</td>
                                                <td>@item.Ngayvaolam.ToString("dd/MM/yyyy")</td>
                                                <td>
                                                    @if (item.Trangthai)
                                                    {
                                                        <span class="badge badge-success">Hoạt động</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-secondary">Ngưng</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button type="button"
                                                            class="btn btn-sm btn-secondary edit-nhanvien"
                                                            data-id="@item.Id">
                                                        Sửa
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm @(item.Trangthai ? "btn-warning" : "btn-success") toggle-status"
                                                            data-id="@item.Id"
                                                            data-status="@item.Trangthai">
                                                        @(item.Trangthai ? "Ngưng" : "Kích hoạt")
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/NhanVien/_CreateModal.cshtml", Model)

<div class="modal fade"
     id="NhanVienEditModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="NhanVienEditModalLabel"
     data-backdrop="static">

    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var _nhanVienService = abp.services.app.nhanvien;

            // =========================
            // THÊM NHÂN VIÊN
            // =========================
            $('#NhanVienCreateModal form[name="NhanVienCreateForm"]').on('submit', function (e) {
                e.preventDefault();

                var form = $(this);

                var input = {
                    hoten: form.find('[name="Hoten"]').val().trim(),
                    gioitinh: form.find('[name="Gioitinh"]').val() === 'true',
                    ngaysinh: form.find('[name="Ngaysinh"]').val(),
                    ngayvaolam: form.find('[name="Ngayvaolam"]').val(),
                    sdt: form.find('[name="SDT"]').val().trim()
                };

                if (!input.hoten) {
                    abp.message.warn('Vui lòng nhập họ và tên.');
                    return;
                }

                if (!input.sdt) {
                    abp.message.warn('Vui lòng nhập số điện thoại.');
                    return;
                }

                if (!input.ngayvaolam) {
                    abp.message.warn('Vui lòng nhập ngày vào làm.');
                    return;
                }

                abp.ui.setBusy($('#NhanVienCreateModal'));

                _nhanVienService.create(input)
                    .done(function () {
                        abp.notify.success('Thêm nhân viên thành công.');
                        $('#NhanVienCreateModal').modal('hide');

                        setTimeout(function () {
                            location.reload();
                        }, 500);
                    })
                    .fail(function (error) {
                        abp.message.error(
                            getErrorMessage(error, 'Không thể thêm nhân viên.')
                        );
                    })
                    .always(function () {
                        abp.ui.clearBusy($('#NhanVienCreateModal'));
                    });
            });

            // =========================
            // MỞ MODAL SỬA
            // =========================
            $(document).on('click', '.edit-nhanvien', function () {
                var id = parseInt($(this).data('id'), 10);
                var modal = $('#NhanVienEditModal');

                modal.find('.modal-content').html(
                    '<div class="modal-body text-center p-5">' +
                    '<i class="fa fa-spinner fa-spin"></i> Đang tải...' +
                    '</div>'
                );

                modal.modal('show');

                modal.find('.modal-content').load(
                    '@Url.Action("EditModal", "NhanVien")?id=' + id
                );
            });

            // =========================
            // SỬA NHÂN VIÊN
            // =========================
            $(document).on('submit', 'form[name="NhanVienEditForm"]', function (e) {
                e.preventDefault();

                var form = $(this);

                var input = {
                    id: parseInt(form.find('[name="Id"]').val(), 10),
                    hoten: form.find('[name="Hoten"]').val().trim(),
                    gioitinh: form.find('[name="Gioitinh"]').val() === 'true',
                    ngaysinh: form.find('[name="Ngaysinh"]').val(),
                    ngayvaolam: form.find('[name="Ngayvaolam"]').val(),
                    sdt: form.find('[name="SDT"]').val().trim(),
                    trangthai: form.find('[name="Trangthai"]').val() === 'true'
                };

                if (!input.hoten) {
                    abp.message.warn('Vui lòng nhập họ và tên.');
                    return;
                }

                if (!input.sdt) {
                    abp.message.warn('Vui lòng nhập số điện thoại.');
                    return;
                }

                if (!input.ngayvaolam) {
                    abp.message.warn('Vui lòng nhập ngày vào làm.');
                    return;
                }

                abp.ui.setBusy($('#NhanVienEditModal'));

                _nhanVienService.update(input)
                    .done(function () {
                        abp.notify.success('Cập nhật nhân viên thành công.');
                        $('#NhanVienEditModal').modal('hide');

                        setTimeout(function () {
                            location.reload();
                        }, 500);
                    })
                    .fail(function (error) {
                        abp.message.error(
                            getErrorMessage(error, 'Không thể cập nhật nhân viên.')
                        );
                    })
                    .always(function () {
                        abp.ui.clearBusy($('#NhanVienEditModal'));
                    });
            });

            // =========================
            // NGƯNG / KÍCH HOẠT
            // =========================
            $(document).on('click', '.toggle-status', function () {
                var button = $(this);
                var id = parseInt(button.data('id'), 10);
                var currentStatus = String(button.data('status')).toLowerCase() === 'true';
                var newStatus = !currentStatus;

                var message = newStatus
                    ? 'Bạn có muốn kích hoạt nhân viên này?'
                    : 'Bạn có muốn ngưng nhân viên này?';

                abp.message.confirm(
                    message,
                    'Xác nhận',
                    function (confirmed) {
                        if (!confirmed) {
                            return;
                        }

                        _nhanVienService.changeTrangThai({
                            id: id,
                            trangthai: newStatus
                        })
                        .done(function () {
                            abp.notify.success(
                                newStatus
                                    ? 'Đã kích hoạt nhân viên.'
                                    : 'Đã ngưng nhân viên.'
                            );

                            setTimeout(function () {
                                location.reload();
                            }, 500);
                        })
                        .fail(function (error) {
                            abp.message.error(
                                getErrorMessage(
                                    error,
                                    'Không thể thay đổi trạng thái nhân viên.'
                                )
                            );
                        });
                    }
                );
            });

            // =========================
            // XỬ LÝ LỖI
            // =========================
            function getErrorMessage(error, defaultMessage) {
                if (error && error.responseJSON && error.responseJSON.error) {
                    return error.responseJSON.error.message ||
                        error.responseJSON.error.details ||
                        defaultMessage;
                }

                if (error && error.error) {
                    return error.error.message ||
                        error.error.details ||
                        defaultMessage;
                }

                if (error && error.message) {
                    return error.message;
                }

                return defaultMessage;
            }
        });
    </script>
}