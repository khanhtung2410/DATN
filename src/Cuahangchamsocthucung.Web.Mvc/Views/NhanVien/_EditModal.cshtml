@using Cuahangchamsocthucung.Web.Models.Common.Modals
@using Cuahangchamsocthucung.NhanVien.Dto
@model NhanVienDto

@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title">Sửa nhân viên</h5>
    <button type="button" class="close" data-dismiss="modal">
        <span>&times;</span>
    </button>
</div>

<form name="NhanVienEditForm" role="form" class="form-horizontal">
    <div class="modal-body">
        <input type="hidden" name="Id" value="@Model.Id" />

        <div class="form-group row required">
            <label class="col-md-3 col-form-label">Họ và tên</label>
            <div class="col-md-9">
                <input type="text" name="Hoten" class="form-control" value="@Model.Hoten" required />
            </div>
        </div>

        <div class="form-group row">
            <label class="col-md-3 col-form-label">Giới tính</label>
            <div class="col-md-9">
                <select name="Gioitinh" class="form-control">
                    <option value="true" selected="@(Model.Gioitinh)">Nam</option>
                    <option value="false" selected="@(!Model.Gioitinh)">Nữ</option>
                </select>
            </div>
        </div>

        <div class="form-group row">
            <label class="col-md-3 col-form-label">Ngày sinh</label>
            <div class="col-md-9">
                <input type="date" name="Ngaysinh" class="form-control" value="@Model.Ngaysinh.ToString("yyyy-MM-dd")" />
            </div>
        </div>

        <div class="form-group row required">
            <label class="col-md-3 col-form-label">Ngày vào làm</label>
            <div class="col-md-9">
                <input type="date" name="Ngayvaolam" class="form-control" value="@Model.Ngayvaolam.ToString("yyyy-MM-dd")" required />
            </div>
        </div>

        <div class="form-group row required">
            <label class="col-md-3 col-form-label">Số điện thoại</label>
            <div class="col-md-9">
                <input type="text" name="SDT" class="form-control" value="@Model.SDT" maxlength="10" required />
            </div>
        </div>

        <div class="form-group row">
            <label class="col-md-3 col-form-label">Trạng thái</label>
            <div class="col-md-9">
                <select name="Trangthai" class="form-control">
                    <option value="true" selected="@(Model.Trangthai)">Hoạt động</option>
                    <option value="false" selected="@(!Model.Trangthai)">Ngưng</option>
                </select>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
</form>