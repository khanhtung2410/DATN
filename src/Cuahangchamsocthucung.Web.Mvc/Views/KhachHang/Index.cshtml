@model Cuahangchamsocthucung.Web.Models.KhachHang.KhachHangListViewModel

@{
    ViewBag.Title = "Danh sách khách hàng";
    ViewBag.CurrentPageName = "Khách hàng";
}

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-md-5">
                        <div class="input-group">
                            <div class="input-group-prepend">
                                <span class="input-group-text"><i class="fa fa-search"></i></span>
                            </div>
                            <input type="text" id="customerSearch" class="form-control" placeholder="Tìm kiếm khách hàng...">
                        </div>
                    </div>
                    <div class="col-md-7 mt-2 mt-md-0 text-md-right">
                        <label class="mb-0">
                            Hiển thị
                            <select id="customerPageSize" class="custom-select custom-select-sm" style="width:80px;">
                                <option value="10">10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                                <option value="100">100</option>
                            </select>
                            khách hàng
                        </label>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table id="KhachHangTable" class="table table-striped table-bordered mb-0">
                        <thead>
                            <tr>
                                <th>Họ tên</th>
                                <th>Số điện thoại</th>
                                <th>Email</th>
                                <th class="sortable" data-column="3" style="cursor:pointer;">Cấp VIP <i class="fa fa-sort text-muted ml-1"></i></th>
                                <th class="sortable" data-column="4" style="cursor:pointer;">Tổng chi tiêu <i class="fa fa-sort text-muted ml-1"></i></th>
                                <th style="width:150px;">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.KhachHangs != null && Model.KhachHangs.Any())
                            {
                                foreach (var item in Model.KhachHangs)
                                {
                                    <tr class="customer-row" data-vip="@item.CapVip" data-total="@item.TongChiTieu">
                                        <td><strong>@item.Hoten</strong></td>
                                        <td>@item.SDT</td>
                                        <td>@(string.IsNullOrEmpty(item.Email) ? "-" : item.Email)</td>
                                        <td>
                                            @if (item.CapVip > 0)
                                            {
                                                <span class="badge badge-warning">@item.TenVip</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">Thường</span>
                                            }
                                        </td>
                                        <td><strong>@item.TongChiTieu.ToString("N0") đ</strong></td>
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm btn-info btn-chi-tiet" data-id="@item.Id">
                                                <i class="fa fa-eye"></i> Chi tiết
                                            </button>
                                            <button type="button" class="btn btn-sm btn-warning toggle-status" data-id="@item.Id">
                                                <i class="fa fa-power-off"></i> Đổi trạng thái
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <div class="row mt-3 align-items-center">
                    <div class="col-md-6">
                        <span id="customerInfo" class="text-muted"></span>
                    </div>
                    <div class="col-md-6">
                        <div id="customerPagination" class="d-flex justify-content-md-end mt-2 mt-md-0"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("_ChiTietKhachHangModal")
@section Scripts {
    <script src="~/view-resources/Views/KhachHang/index.js"></script>
}