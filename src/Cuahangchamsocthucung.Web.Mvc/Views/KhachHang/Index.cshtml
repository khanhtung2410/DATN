@model Cuahangchamsocthucung.Web.Models.KhachHang.KhachHangListViewModel
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Danh sách khách hàng";
    ViewBag.CurrentPageName = "Khách hàng";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Khách hàng</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="javascript:;" data-toggle="modal" data-target="#CreateModal" class="btn bg-blue">
                    <i class="fa fa-plus-square"></i> Thêm
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6"></div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="KhachHangTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width: 100px"></th>
                                        <th>Tên</th>
                                        <th>Số điện thoại</th>
                                        <th>Email</th>
                                        <th style="width: 200px">Hành động</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model?.KhachHangs != null)
                                    {
                                        foreach (var item in Model.KhachHangs)
                                        {
                                            <tr>
                                                <td>
                                                    @if (item.ThuCungs != null && item.ThuCungs.Any())
                                                    {
                                                        <button class="btn btn-sm btn-info"
                                                                data-toggle="collapse"
                                                                href="#tc-@item.Id"
                                                                role="button"
                                                                aria-expanded="false"
                                                                aria-controls="tc-@item.Id">
                                                            <i class="fa fa-paw"></i> Thú cưng
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">Không có</span>
                                                    }
                                                </td>

                                                <td>@item.Hoten</td>
                                                <td>@item.SDT</td>
                                                <td>@item.Email</td>

                                                <td>
                                                    <button class="btn btn-sm btn-secondary edit-khachhang"
                                                            data-id="@item.Id"
                                                            data-toggle="modal"
                                                            data-target="#KhachHangEditModal">
                                                        Sửa
                                                    </button>

                                                    <button class="btn btn-sm btn-warning toggle-status"
                                                            data-id="@item.Id"
                                                            data-status="true">
                                                        Kích hoạt
                                                    </button>

                                                    <button class="btn btn-sm btn-danger delete-khachhang"
                                                            data-id="@item.Id">
                                                        Xóa
                                                    </button>
                                                </td>
                                            </tr>

                                            <tr class="collapse-row">
                                                <td colspan="5" class="p-0">
                                                    <div class="collapse" id="tc-@item.Id">
                                                        <div class="p-3">
                                                            <h6 class="mb-3">
                                                                <i class="fa fa-paw"></i>
                                                                Danh sách thú cưng của @item.Hoten
                                                            </h6>

                                                            @if (item.ThuCungs != null && item.ThuCungs.Any())
                                                            {
                                                                <div class="table-responsive">
                                                                    <table class="table table-sm table-bordered mb-0">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Tên thú cưng</th>
                                                                                <th>Loại</th>
                                                                                <th>Ghi chú</th>
                                                                                <th>Trạng thái</th>
                                                                            </tr>
                                                                        </thead>

                                                                        <tbody>
                                                                            @foreach (var tc in item.ThuCungs)
                                                                            {
                                                                                <tr>
                                                                                    <td>
                                                                                        <strong>@tc.TenThuCung</strong>
                                                                                    </td>

                                                                                    <td>
                                                                                        @if (tc.LoaiThuCung == "Chó")
                                                                                        {
                                                                                            <span>🐶 Chó</span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span>🐱 Mèo</span>
                                                                                        }
                                                                                </td>

                                                                                <td>
                                                                                    @(string.IsNullOrEmpty(tc.GhiChu)
                                                                                                                                                            ? "-"
                                                                                                                                                            : tc.GhiChu)
                                                                    </td>

                                                                                    <td>
                                                                        @if (tc.TrangThai)
                                                                                        {
                                                                                            <span class="badge badge-success">
                                                                                                Hoạt động
                                                                                            </span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span class="badge badge-secondary">
                                                                                                Không hoạt động
                                                                                            </span>
                                                                                        }
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            }
                                                            else
                                                            {
                                                                <div class="text-muted">
                                                                    Khách hàng chưa có thú cưng.
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
}

@await Html.PartialAsync(
"~/Views/KhachHang/_CreateModal.cshtml",
    Model
)

<div class="modal fade"
     id="KhachHangEditModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="KhachHangEditModalLabel"
     data-backdrop="static">

    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>