@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title font-weight-bold">Sửa lịch chăm sóc</h5>
    <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
</div>

<form id="lichchamsoc-edit-form">
    <input type="hidden" id="edit-lich-id" />

    <div class="modal-body">
        <div class="form-group">
            <label class="font-weight-bold">Khách hàng</label>
            <input type="text" id="edit-lich-khachhang" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Thú cưng</label>
            <input type="text" id="edit-lich-thucung" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Cân nặng (kg)</label>
            <input type="number" id="edit-lich-cannang" class="form-control" min="0.1" step="0.1" placeholder="Nhập cân nặng thú cưng..." />
            <small class="form-text text-muted">Nhập cân nặng để lọc bảng giá phù hợp.</small>
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Dịch vụ <span class="text-danger">*</span></label>
            <select id="edit-lich-dichvu" class="form-control">
                <option value="">-- Chọn dịch vụ --</option>
            </select>
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Bảng giá <span class="text-danger">*</span></label>
            <select id="edit-lich-banggia" class="form-control" disabled>
                <option value="">-- Chọn dịch vụ trước --</option>
            </select>
        </div>

        <div id="edit-lich-banggia-info"></div>

        <div class="form-group">
            <label class="font-weight-bold">Thời gian <span class="text-danger">*</span></label>
            <input type="text" id="edit-lich-thoigian" class="form-control" placeholder="dd/MM/yyyy HH:mm" autocomplete="off" />
            <small class="form-text text-muted">Ví dụ: 25/08/2026 14:30</small>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" id="btnDongEditLich" class="btn btn-secondary">Hủy</button>
        <button type="submit" id="btnLuuEditLich" class="btn btn-warning">
            <i class="fas fa-save"></i> Lưu thay đổi
        </button>
    </div>
</form>