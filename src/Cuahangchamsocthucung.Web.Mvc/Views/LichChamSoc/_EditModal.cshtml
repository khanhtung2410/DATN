@{
    Layout = null;
}

<div class="modal-header">
    <h5 class="modal-title font-weight-bold">Sửa lịch chăm sóc</h5>
    <button type="button" class="close" data-dismiss="modal" aria-label="Đóng">
        <span aria-hidden="true">&times;</span>
    </button>
</div>

<form id="lichchamsoc-edit-form">
    <input type="hidden" id="edit-lich-id" />

    <div class="modal-body">
        <div class="form-group">
            <label class="font-weight-bold">Khách hàng</label>
            <input type="text" id="edit-lich-khachhang" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Thú cưng</label>
            <input type="text" id="edit-lich-thucung" class="form-control" readonly />
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Dịch vụ <span class="text-danger">*</span></label>
            <select id="edit-lich-dichvu" class="form-control">
                <option value="">-- Đang tải dịch vụ --</option>
            </select>
        </div>

        <div class="form-group">
            <label class="font-weight-bold">Bảng giá <span class="text-danger">*</span></label>
            <select id="edit-lich-banggia" class="form-control" disabled>
                <option value="">-- Chọn dịch vụ trước --</option>
            </select>
        </div>

        <div id="edit-lich-banggia-info" class="mb-3"></div>

        <div class="form-group">
            <label class="font-weight-bold">
                Thời gian <span class="text-danger">*</span>
            </label>
            <input type="text"
                   id="edit-lich-thoigian"
                   class="form-control"
                   placeholder="dd/mm/yyyy HH:mm"
                   autocomplete="off" />
            <small class="form-text text-muted">Định dạng: ngày/tháng/năm giờ:phút, ví dụ 25/08/2026 14:30</small>
        </div>
    </div>

    <div class="modal-footer">
        <button type="button" id="btnDongEditLich" class="btn btn-secondary">
            Hủy
        </button>
        <button type="submit" id="btnLuuEditLich" class="btn btn-warning">
            <i class="fas fa-save"></i> Lưu thay đổi
        </button>
    </div>
</form>

<script>
    $(function () {
        var editLichChamSocId = 0;
        var editBangGiaId = 0;

        function getErrorMessage(error, defaultMessage) {
            if (error && error.responseJSON && error.responseJSON.error) {
                return error.responseJSON.error.message || error.responseJSON.error.details || defaultMessage;
            }

            if (error && error.error) {
                return error.error.message || error.error.details || defaultMessage;
            }

            return defaultMessage;
        }

        function parseDate(value) {
            if (!value) return null;

            var date = new Date(value);

            if (isNaN(date.getTime())) {
                var match = value.match(/\/Date\((\d+)\)\//);
                if (match) {
                    date = new Date(parseInt(match[1], 10));
                }
            }

            return isNaN(date.getTime()) ? null : date;
        }

        function formatDateTime(value) {
            var date = parseDate(value);

            if (!date) return '';

            var day = String(date.getDate()).padStart(2, '0');
            var month = String(date.getMonth() + 1).padStart(2, '0');
            var year = date.getFullYear();
            var hour = String(date.getHours()).padStart(2, '0');
            var minute = String(date.getMinutes()).padStart(2, '0');

            return day + '/' + month + '/' + year + ' ' + hour + ':' + minute;
        }

        function convertToApiDate(value) {
            var match = /^(\d{2})\/(\d{2})\/(\d{4})\s+(\d{2}):(\d{2})$/.exec(value);

            if (!match) {
                return null;
            }

            var day = parseInt(match[1], 10);
            var month = parseInt(match[2], 10);
            var year = parseInt(match[3], 10);
            var hour = parseInt(match[4], 10);
            var minute = parseInt(match[5], 10);

            var date = new Date(year, month - 1, day, hour, minute);

            if (date.getFullYear() !== year ||
                date.getMonth() !== month - 1 ||
                date.getDate() !== day ||
                date.getHours() !== hour ||
                date.getMinutes() !== minute) {
                return null;
            }

            return year + '-' +
                String(month).padStart(2, '0') + '-' +
                String(day).padStart(2, '0') + 'T' +
                String(hour).padStart(2, '0') + ':' +
                String(minute).padStart(2, '0') + ':00';
        }

        function loadDichVu(selectedDichVuId, selectedBangGiaId) {
            var selectDichVu = $('#edit-lich-dichvu');

            selectDichVu.html('<option value="">-- Đang tải dịch vụ --</option>');

            abp.services.app.dichVu.getAll()
                .done(function (result) {
                    var list = Array.isArray(result) ? result : (result.items || []);

                    selectDichVu.empty().append('<option value="">-- Chọn dịch vụ --</option>');

                    $.each(list, function (index, item) {
                        var option = $('<option>', {
                            value: item.id,
                            text: item.tenDichVu
                        });

                        if (parseInt(item.id, 10) === parseInt(selectedDichVuId, 10)) {
                            option.prop('selected', true);
                        }

                        selectDichVu.append(option);
                    });

                    if (selectedDichVuId) {
                        loadBangGia(selectedDichVuId, selectedBangGiaId);
                    }
                })
                .fail(function (error) {
                    selectDichVu.html('<option value="">-- Không tải được dịch vụ --</option>');
                    abp.message.error(getErrorMessage(error, 'Không thể tải danh sách dịch vụ.'));
                });
        }

        function loadBangGia(dichVuId, selectedBangGiaId) {
            var selectBangGia = $('#edit-lich-banggia');

            selectBangGia.empty()
                .append('<option value="">-- Đang tải bảng giá --</option>')
                .prop('disabled', true);

            $('#edit-lich-banggia-info').empty();

            if (!dichVuId) {
                selectBangGia.html('<option value="">-- Chọn dịch vụ trước --</option>');
                return;
            }

            abp.services.app.dichVu.getDichVu(dichVuId)
                .done(function (result) {
                    var list = result.bangGias || result.BangGias || result.bangGia || [];

                    selectBangGia.empty().append('<option value="">-- Chọn bảng giá --</option>');

                    $.each(list, function (index, item) {
                        var id = item.id || item.Id;
                        var ten = item.tenBangGia || item.TenBangGia || '';
                        var gia = item.gia || item.Gia || 0;
                        var thoiGian = item.thoiGianPhut || item.ThoiGianPhut || 0;

                        var text = ten;

                        if (gia) {
                            text += ' - ' + Number(gia).toLocaleString('vi-VN') + ' đ';
                        }

                        if (thoiGian) {
                            text += ' - ' + thoiGian + ' phút';
                        }

                        var option = $('<option>', {
                            value: id,
                            text: text
                        });

                        option.data('gia', gia);
                        option.data('thoigian', thoiGian);

                        if (parseInt(id, 10) === parseInt(selectedBangGiaId, 10)) {
                            option.prop('selected', true);
                        }

                        selectBangGia.append(option);
                    });

                    selectBangGia.prop('disabled', false);
                    showBangGiaInfo();
                })
                .fail(function (error) {
                    selectBangGia.html('<option value="">-- Không tải được bảng giá --</option>');
                    abp.message.error(getErrorMessage(error, 'Không thể tải bảng giá của dịch vụ.'));
                });
        }

        function showBangGiaInfo() {
            var option = $('#edit-lich-banggia option:selected');

            var gia = option.data('gia');
            var thoiGian = option.data('thoigian');

            if (!gia && !thoiGian) {
                $('#edit-lich-banggia-info').empty();
                return;
            }

            var html = '<div class="alert alert-info mb-0">';

            if (gia) {
                html += '<strong>Giá:</strong> ' + Number(gia).toLocaleString('vi-VN') + ' đ';
            }

            if (thoiGian) {
                if (gia) html += ' &nbsp;|&nbsp; ';
                html += '<strong>Thời gian dịch vụ:</strong> ' + thoiGian + ' phút';
            }

            html += '</div>';

            $('#edit-lich-banggia-info').html(html);
        }

        function loadLichChamSoc(id) {
            editLichChamSocId = id;

            abp.services.app.lichChamSoc.getLichChamSoc(id)
                .done(function (result) {
                    $('#edit-lich-id').val(result.id);
                    $('#edit-lich-khachhang').val(result.tenKhachHang || 'Không xác định');
                    $('#edit-lich-thucung').val(result.tenThuCung || 'Không xác định');
                    $('#edit-lich-thoigian').val(formatDateTime(result.thoiGian));

                    editBangGiaId = result.bangGiaId;

                    loadDichVu(result.dichVuId, result.bangGiaId);
                })
                .fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể tải thông tin lịch chăm sóc.'));
                });
        }

        $('#edit-lich-dichvu').on('change', function () {
            var dichVuId = parseInt($(this).val(), 10) || 0;

            loadBangGia(dichVuId, 0);
        });

        $('#edit-lich-banggia').on('change', function () {
            showBangGiaInfo();
        });

        $('#btnDongEditLich').on('click', function () {
            $('#LichChamSocEditModal').modal('hide');
        });

        $('#lichchamsoc-edit-form').on('submit', function (e) {
            e.preventDefault();

            var id = parseInt($('#edit-lich-id').val(), 10);
            var dichVuId = parseInt($('#edit-lich-dichvu').val(), 10);
            var bangGiaId = parseInt($('#edit-lich-banggia').val(), 10);
            var thoiGianText = $.trim($('#edit-lich-thoigian').val());

            if (!id) {
                abp.message.error('Không xác định được lịch chăm sóc.');
                return;
            }

            if (!dichVuId) {
                abp.message.warn('Vui lòng chọn dịch vụ.');
                return;
            }

            if (!bangGiaId) {
                abp.message.warn('Vui lòng chọn bảng giá.');
                return;
            }

            var thoiGian = convertToApiDate(thoiGianText);

            if (!thoiGian) {
                abp.message.warn('Thời gian không hợp lệ. Vui lòng nhập theo định dạng dd/MM/yyyy HH:mm.');
                return;
            }

            var button = $('#btnLuuEditLich');

            button.prop('disabled', true);

            var input = {
                id: id,
                dichVuId: dichVuId,
                bangGiaId: bangGiaId,
                thoiGian: thoiGian
            };

            abp.services.app.lichChamSoc.update(input)
                .done(function () {
                    abp.notify.success('Cập nhật lịch chăm sóc thành công.');

                    $('#LichChamSocEditModal').modal('hide');

                    setTimeout(function () {
                        location.reload();
                    }, 500);
                })
                .fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể cập nhật lịch chăm sóc.'));
                })
                .always(function () {
                    button.prop('disabled', false);
                });
        });

        // Cho Index gọi khi click nút Sửa
        window.loadEditLichChamSoc = function (id) {
            $('#LichChamSocEditModal').modal('show');
            loadLichChamSoc(id);
        };
    });
</script>