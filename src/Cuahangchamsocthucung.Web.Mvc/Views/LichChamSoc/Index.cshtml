@model Cuahangchamsocthucung.Web.Models.LichChamSoc.LichChamSocListViewModel
@using Cuahangchamsocthucung.Enum

@{
    ViewBag.Title = "Lịch chăm sóc";
    ViewBag.CurrentPageName = "Lịch chăm sóc";
}

@functions {
    string HienThiTrangThai(TrangThaiLichChamSoc trangThai)
    {
        switch (trangThai)
        {
            case TrangThaiLichChamSoc.ChoXacNhan: return "Chờ xác nhận";
            case TrangThaiLichChamSoc.DaXacNhan: return "Đã xác nhận";
            case TrangThaiLichChamSoc.DangDienRa: return "Đang diễn ra";
            case TrangThaiLichChamSoc.DaHuy: return "Đã hủy";
            case TrangThaiLichChamSoc.HoanThanh: return "Hoàn thành";
            case TrangThaiLichChamSoc.BiTuChoi: return "Bị từ chối";
            default: return trangThai.ToString();
        }
    }
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Lịch chăm sóc</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header"></div>
                    <div class="card-body">
                        <!-- FILTER -->
                        <form method="get" asp-action="Index" class="mb-4">
                            <div class="row">
                                <div class="col-md-5">
                                    <div class="form-group mb-0">
                                        <label>Khách hàng</label>
                                        <input type="text"
                                               name="tenKhachHang"
                                               class="form-control"
                                               placeholder="Nhập tên khách hàng..."
                                               value="@Model.TenKhachHang" />
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="form-group mb-0">
                                        <label>Trạng thái</label>
                                        <select name="trangThai" class="form-control">
                                            <option value="">-- Tất cả trạng thái --</option>
                                            @foreach (var status in Enum.GetValues(typeof(TrangThaiLichChamSoc)).Cast<TrangThaiLichChamSoc>())
                                            {
                                                if (Model.TrangThai == status)
                                                {
                                                    <option value="@((int)status)" selected>@HienThiTrangThai(status)</option>
                                                }
                                                else
                                                {
                                                    <option value="@((int)status)">@HienThiTrangThai(status)</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end">
                                    <button type="submit" class="btn btn-primary mr-2">
                                        <i class="fas fa-search"></i> Lọc
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fas fa-redo"></i> Xóa lọc
                                    </a>
                                </div>
                            </div>
                        </form>

                        <!-- TABLE -->
                        <div class="table-responsive">
                            <table id="LichChamSocTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Ngày</th>
                                        <th>Khách hàng</th>
                                        <th>Nhân viên</th>
                                        <th>Trạng thái</th>
                                        <th class="text-center" style="min-width:520px;white-space:nowrap;">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.LichChamSocs != null && Model.LichChamSocs.Any())
                                    {
                                        foreach (var item in Model.LichChamSocs)
                                        {
                                            <tr>
                                                <td></td>
                                                <td>@item.ThoiGian.ToString("dd/MM/yyyy HH:mm")</td>
                                                <td>@item.TenKhachHang</td>
                                                <td>@(string.IsNullOrEmpty(item.TenNhanVien) ? "Chưa phân công" : item.TenNhanVien)</td>
                                                <td>@HienThiTrangThai(item.TrangThai)</td>
                                                <td class="text-center" style="white-space:nowrap;">
                                                    <div class="d-flex justify-content-center align-items-center" style="gap:5px;">
                                                        <button type="button" class="btn btn-sm btn-info xem-chi-tiet" data-id="@item.Id">
                                                            <i class="fas fa-eye"></i> Xem chi tiết
                                                        </button>

                                                        @if (item.TrangThai == TrangThaiLichChamSoc.ChoXacNhan)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-primary phan-cong-lich" data-id="@item.Id">
                                                                <i class="fas fa-user-plus"></i> Phân công
                                                            </button>
                                                        }

                                                        @if (item.TrangThai == TrangThaiLichChamSoc.ChoXacNhan ||
                                                                                                        item.TrangThai == TrangThaiLichChamSoc.DaXacNhan)
                                                        {
                                                            <button type="button" class="btn btn-sm btn-secondary edit-lich" data-id="@item.Id">
                                                                <i class="fas fa-edit"></i> Sửa
                                                            </button>
                                                            <button type="button" class="btn btn-sm btn-danger tu-choi-lich" data-id="@item.Id">
                                                                <i class="fas fa-ban"></i> Từ chối
                                                            </button>
                                                        }
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center text-muted py-4">
                                                <i class="fas fa-calendar-times fa-2x mb-2"></i>
                                                <div>Không tìm thấy lịch chăm sóc phù hợp.</div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- PHÂN TRANG -->
                        @if (Model.TotalPages > 1)
                        {
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <div class="text-muted">
                                    Trang @Model.CurrentPage / @Model.TotalPages
                                </div>

                                <nav>
                                    <ul class="pagination mb-0">
                                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                            @if (Model.CurrentPage > 1)
                                            {
                                                <a class="page-link"
                                                   asp-action="Index"
                                                   asp-route-page="@(Model.CurrentPage - 1)"
                                                   asp-route-tenKhachHang="@Model.TenKhachHang"
                                                   asp-route-trangThai="@Model.TrangThai">
                                                    <i class="fas fa-chevron-left"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="page-link">
                                                    <i class="fas fa-chevron-left"></i>
                                                </span>
                                            }
                                        </li>

                                        @for (var i = 1; i <= Model.TotalPages; i++)
                                        {
                                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                                <a class="page-link"
                                                   asp-action="Index"
                                                   asp-route-page="@i"
                                                   asp-route-tenKhachHang="@Model.TenKhachHang"
                                                   asp-route-trangThai="@Model.TrangThai">
                                                    @i
                                                </a>
                                            </li>
                                        }

                                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                                            @if (Model.CurrentPage < Model.TotalPages)
                                            {
                                                <a class="page-link"
                                                   asp-action="Index"
                                                   asp-route-page="@(Model.CurrentPage + 1)"
                                                   asp-route-tenKhachHang="@Model.TenKhachHang"
                                                   asp-route-trangThai="@Model.TrangThai">
                                                    <i class="fas fa-chevron-right"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="page-link">
                                                    <i class="fas fa-chevron-right"></i>
                                                </span>
                                            }
                                        </li>
                                    </ul>
                                </nav>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- MODAL PHÂN CÔNG -->
<div class="modal fade" id="PhanCongNhanVienModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Phân công nhân viên</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="PhanCongLichId" />
                <div class="form-group">
                    <label>Nhân viên <span class="text-danger">*</span></label>
                    <select id="PhanCongNhanVienId" class="form-control">
                        <option value="">-- Đang tải nhân viên --</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Hủy</button>
                <button type="button" id="btnLuuPhanCong" class="btn btn-primary">Lưu phân công</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL XEM CHI TIẾT -->
<div class="modal fade" id="LichChamSocChiTietModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chi tiết lịch chăm sóc</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Khách hàng</label>
                            <input type="text" id="ChiTietTenKhachHang" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Thú cưng</label>
                            <input type="text" id="ChiTietTenThuCung" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Dịch vụ</label>
                            <input type="text" id="ChiTietTenDichVu" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Nhân viên</label>
                            <input type="text" id="ChiTietTenNhanVien" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Thời gian</label>
                            <input type="text" id="ChiTietThoiGian" class="form-control" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-group">
                            <label>Trạng thái</label>
                            <input type="text" id="ChiTietTrangThai" class="form-control" readonly />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<!-- MODAL SỬA -->
<div class="modal fade" id="LichChamSocEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @await Html.PartialAsync("_EditModal")
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var lichChamSocId = 0;

            // PHÂN CÔNG NHÂN VIÊN
            $(document).on('click', '.phan-cong-lich', function () {
                lichChamSocId = parseInt($(this).data('id'), 10);
                $('#PhanCongLichId').val(lichChamSocId);
                $('#PhanCongNhanVienId').html('<option value="">-- Đang tải nhân viên --</option>');
                $('#PhanCongNhanVienModal').modal('show');

                abp.services.app.nhanvien.getNhanVienDangLamViec()
                    .done(function (result) {
                        var list = Array.isArray(result) ? result : (result.items || []);
                        var select = $('#PhanCongNhanVienId');
                        select.empty().append('<option value="">-- Chọn nhân viên --</option>');

                        $.each(list, function (index, item) {
                            select.append($('<option>', {
                                value: item.id,
                                text: item.hoten + ' - ' + item.sdt
                            }));
                        });

                        if (list.length === 0) {
                            select.append('<option value="" disabled>Không có nhân viên đang làm việc</option>');
                        }
                    })
                    .fail(function (error) {
                        $('#PhanCongNhanVienId').html('<option value="">-- Không tải được nhân viên --</option>');
                        abp.message.error(getErrorMessage(error, 'Không thể tải danh sách nhân viên.'));
                    });
            });

            // LƯU PHÂN CÔNG
            $('#btnLuuPhanCong').on('click', function () {
                var nhanVienId = parseInt($('#PhanCongNhanVienId').val(), 10);

                if (!nhanVienId) {
                    abp.message.warn('Vui lòng chọn nhân viên.');
                    return;
                }

                var button = $(this);
                button.prop('disabled', true);

                abp.services.app.lichChamSoc.phanCongNhanVien(lichChamSocId, nhanVienId)
                    .done(function () {
                        abp.notify.success('Phân công nhân viên thành công.');
                        $('#PhanCongNhanVienModal').modal('hide');

                        setTimeout(function () {
                            location.reload();
                        }, 500);
                    })
                    .fail(function (error) {
                        abp.message.error(getErrorMessage(error, 'Phân công nhân viên không thành công.'));
                    })
                    .always(function () {
                        button.prop('disabled', false);
                    });
            });

            // XEM CHI TIẾT
            $(document).on('click', '.xem-chi-tiet', function () {
                var id = parseInt($(this).data('id'), 10);

                abp.services.app.lichChamSoc.getLichChamSoc(id)
                    .done(function (result) {
                        $('#ChiTietTenKhachHang').val(result.tenKhachHang || '');
                        $('#ChiTietTenThuCung').val(result.tenThuCung || '');
                        $('#ChiTietTenDichVu').val(result.tenDichVu || '');
                        $('#ChiTietTenNhanVien').val(result.tenNhanVien || 'Chưa phân công');
                        $('#ChiTietThoiGian').val(formatDateTime(result.thoiGian));
                        $('#ChiTietTrangThai').val(getTrangThaiText(result.trangThai));
                        $('#LichChamSocChiTietModal').modal('show');
                    })
                    .fail(function (error) {
                        abp.message.error(getErrorMessage(error, 'Không thể tải chi tiết lịch chăm sóc.'));
                    });
            });

            // MỞ MODAL SỬA
            $(document).on('click', '.edit-lich', function () {
                var id = parseInt($(this).data('id'), 10);

                abp.services.app.lichChamSoc.getLichChamSoc(id)
                    .done(function (result) {
                        $('#edit-lich-id').val(result.id);
                        $('#edit-lich-khachhang').val(result.tenKhachHang || '');
                        $('#edit-lich-thucung').val(result.tenThuCung || '');
                        $('#edit-lich-thoigian').val(formatDateTimeLocal(result.thoiGian));

                        if (typeof loadDichVu === 'function') {
                            loadDichVu(result.dichVuId, result.bangGiaId);
                        }

                        $('#LichChamSocEditModal').modal('show');
                    })
                    .fail(function (error) {
                        abp.message.error(getErrorMessage(error, 'Không thể tải thông tin lịch chăm sóc.'));
                    });
            });

            // ADMIN TỪ CHỐI
            $(document).on('click', '.tu-choi-lich', function () {
                var id = parseInt($(this).data('id'), 10);

                abp.message.confirm(
                    'Bạn có chắc chắn muốn từ chối lịch chăm sóc này?',
                    'Xác nhận từ chối',
                    function (isConfirmed) {
                        if (!isConfirmed) return;

                        abp.services.app.lichChamSoc.tuChoiLichChamSoc(id)
                            .done(function () {
                                abp.notify.success('Đã từ chối lịch chăm sóc.');

                                setTimeout(function () {
                                    location.reload();
                                }, 500);
                            })
                            .fail(function (error) {
                                abp.message.error(getErrorMessage(error, 'Không thể từ chối lịch chăm sóc.'));
                            });
                    }
                );
            });

            // TRẠNG THÁI
            function getTrangThaiText(trangThai) {
                switch (trangThai) {
                    case 0: return 'Chờ xác nhận';
                    case 1: return 'Đã xác nhận';
                    case 2: return 'Đang diễn ra';
                    case 3: return 'Đã hủy';
                    case 4: return 'Hoàn thành';
                    case 5: return 'Bị từ chối';
                    default: return 'Không xác định';
                }
            }

            // FORMAT NGÀY
            function formatDateTime(value) {
                if (!value) return '';

                var date = new Date(value);

                if (isNaN(date.getTime())) return value;

                var day = String(date.getDate()).padStart(2, '0');
                var month = String(date.getMonth() + 1).padStart(2, '0');
                var year = date.getFullYear();
                var hours = String(date.getHours()).padStart(2, '0');
                var minutes = String(date.getMinutes()).padStart(2, '0');

                return day + '/' + month + '/' + year + ' ' + hours + ':' + minutes;
            }

            function formatDateTimeLocal(value) {
                if (!value) return '';

                var date = new Date(value);

                if (isNaN(date.getTime())) return '';

                var year = date.getFullYear();
                var month = String(date.getMonth() + 1).padStart(2, '0');
                var day = String(date.getDate()).padStart(2, '0');
                var hours = String(date.getHours()).padStart(2, '0');
                var minutes = String(date.getMinutes()).padStart(2, '0');

                return year + '-' + month + '-' + day + 'T' + hours + ':' + minutes;
            }

            // ERROR
            function getErrorMessage(error, defaultMessage) {
                if (error && error.responseJSON && error.responseJSON.error) {
                    return error.responseJSON.error.message ||
                        error.responseJSON.error.details ||
                        defaultMessage;
                }

                if (error && error.error) {
                    return error.error.message ||
                        error.error.details ||
                        defaultMessage;
                }

                return defaultMessage;
            }
        });
    </script>
}