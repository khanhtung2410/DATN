@model Cuahangchamsocthucung.Web.Models.LichChamSoc.LichChamSocListViewModel
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Lịch chăm sóc";
    ViewBag.CurrentPageName = "Lịch chăm sóc";
}
<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Lịch chăm sóc</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="javascript:;" data-toggle="modal" data-target="#CreateModal" class="btn bg-blue">
                    <i class="fa fa-plus-square"></i> Thêm
                </a>
            </div>
        </div>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="LichChamSocTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Ngày</th>
                                        <th>Khách hàng</th>
                                        <th>Nhân viên</th>
                                        <th>Mô tả</th>
                                        <th style="width: 200px">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {

}

@await Html.PartialAsync("~/Views/LichChamSoc/_CreateModal.cshtml", Model)

<div class="modal fade" id="LichChamSocEditModal" tabindex="-1" role="dialog" aria-labelledby="LichChamSocEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>
