@model Cuahangchamsocthucung.Web.Models.DichVu.DichVuListViewModel
@using System.Security.Claims
@using Cuahangchamsocthucung.Enum
@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Danh sách dịch vụ";
    ViewBag.CurrentPageName = "Dịch vụ";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Dịch vụ</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="javascript:;" data-toggle="modal" data-target="#DichVuCreateModal" class="btn bg-blue">
                    <i class="fa fa-plus-square"></i> Thêm
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header"></div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="DichVuTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Tên</th>
                                        <th>Mô tả</th>
                                        <th>Trạng thái</th>
                                        <th style="width:150px">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.DichVus != null)
                                    {
                                        foreach (var item in Model.DichVus)
                                        {
                                            var isLuuTru = item.LoaiDichVu == LoaiDichVu.LuuTru;

                                            <tr>
                                                <td>
                                                    <a class="btn btn-sm btn-info"
                                                       data-toggle="collapse"
                                                       href="#bg-@item.Id"
                                                       role="button"
                                                       aria-expanded="false"
                                                       aria-controls="bg-@item.Id">
                                                        Giá
                                                    </a>
                                                </td>
                                                <td>@item.Tendichvu</td>
                                                <td>@item.Mota</td>
                                                <td>@(item.Trangthai ? "Hoạt động" : "Ngưng")</td>
                                                <td>
                                                    <button type="button"
                                                            class="btn btn-sm btn-secondary edit-dichvu"
                                                            data-id="@item.Id"
                                                            data-toggle="modal"
                                                            data-target="#DichVuEditModal">
                                                        Sửa
                                                    </button>

                                                    <button type="button"
                                                            class="btn btn-sm btn-warning toggle-status"
                                                            data-id="@item.Id"
                                                            data-status="@item.Trangthai">
                                                        @(item.Trangthai ? "Ngưng" : "Kích hoạt")
                                                    </button>
                                                </td>
                                            </tr>

                                            <tr class="collapse-row">
                                                <td colspan="5" class="p-0">
                                                    <div class="collapse" id="bg-@item.Id">
                                                        <div class="p-3">
                                                            <h6>Danh sách mức giá</h6>
                                                            <div class="table-responsive">
                                                                <table class="table table-sm table-bordered mb-0">
                                                                    <thead>
                                                                        <tr>
                                                                            <th>Đối tượng</th>
                                                                            <th class="text-center">Loại phòng</th>
                                                                            <th class="text-center">Lông dài</th>
                                                                            <th class="text-center">Cân nặng / Ghi chú</th>
                                                                            <th class="text-center">Thời gian</th>
                                                                            <th class="text-right">Giá</th>
                                                                            <th class="text-center">Hành động</th>
                                                                        </tr>
                                                                    </thead>
                                                                    <tbody>
                                                                        @if (item.BangGias != null && item.BangGias.Any())
                                                                        {
                                                                            foreach (var bg in item.BangGias)
                                                                            {
                                                                                <tr data-bg-id="@bg.Id">
                                                                                    <td>@bg.Loaithucung</td>
                                                                                    <td class="text-center">
                                                                                        @(string.IsNullOrEmpty(bg.LoaiPhong) ? "-" : bg.LoaiPhong)
                                                                                    </td>
                                                                                    <td class="text-center">
                                                                                        @(item.LoaiDichVu == LoaiDichVu.LuuTru ? "-" : (bg.Loailong ? "Có" : "Không"))
                                                                                    </td>
                                                                                    <td class="text-center">
                                                                                        @(item.LoaiDichVu == LoaiDichVu.LuuTru ? $"≤ {bg.Cannangden} kg" : $"{bg.Cannangtu} - {bg.Cannangden} kg")
                                                                                    
                                                                    </td>
                                                                    <td class="text-center">
                                                                        @bg.ThoiGianPhut phút
                                                                    </td>
                                                                    <td class="text-right">
                                                                        @string.Format("{0:N0}", bg.Giadv) ₫
                                                                    </td>
                                                                    <td class="text-center">
                                                                        <button type="button"
                                                                                class="btn btn-sm btn-secondary edit-banggia"
                                                                                data-id="@bg.Id"
                                                                                data-dichvu="@item.Id"
                                                                                data-dichvuname="@item.Tendichvu"
                                                                                data-trangthai="@item.Trangthai"
                                                                                data-loaithucung="@bg.Loaithucung"
                                                                                data-loaiphong="@bg.LoaiPhong"
                                                                                data-loailong="@bg.Loailong"
                                                                                data-cannangtu="@bg.Cannangtu"
                                                                                data-cannangden="@bg.Cannangden"
                                                                                data-giadv="@bg.Giadv"
                                                                                data-thoigianphut="@bg.ThoiGianPhut"
                                                                                data-toggle="modal"
                                                                                data-target="#BangGiaEditModal">
                                                                            Sửa
                                                                        </button>
                                                                    </td>
                                                                </tr>
                                                                                                                                }
                                                                        }
                                                                        else
                                                                        {
                                                                            <tr>
                                                                                <td colspan="7" class="text-center">
                                                                                    Không có mức giá.
                                                                                </td>
                                                                            </tr>
                                                                        }
                                                                    </tbody>
                                                                </table>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    @await Html.PartialAsync(
    "~/Views/DichVu/_DichVuCreateModal.cshtml",
        new Cuahangchamsocthucung.DichVu.Dto.ThemDichVuDto())

@await Html.PartialAsync(
        "~/Views/DichVu/_DichVuEditModal.cshtml",
        new Cuahangchamsocthucung.DichVu.Dto.SuaDichVuDto())

@await Html.PartialAsync(
        "~/Views/DichVu/_BangGiaEditModal.cshtml",
        new Cuahangchamsocthucung.DichVu.Dto.SuaBangGiaDto())

<script>
    $(function () {
        // ==================== SỬA DỊCH VỤ ====================
        $(document).on('click', '.edit-dichvu', function () {
            var id = parseInt($(this).attr('data-id')) || 0;
            var modal = $('#DichVuEditModal');

            console.log('ID dịch vụ cần sửa:', id);

            if (!id) {
                abp.notify.error('Không xác định được ID dịch vụ.');
                return;
            }

            // Quan trọng: truyền ID vào modal
            modal.attr('data-id', id);
            modal.data('id', id);
            modal.find('#dv-edit-id').val(id);
        });

        // ==================== SỬA BẢNG GIÁ ====================
        $(document).on('click', '.edit-banggia', function () {
            var btn = $(this);

            $('#bg-id').val(btn.attr('data-id'));
            $('#bg-dichvu-id').val(btn.attr('data-dichvu'));
            $('#bg-loaithucung').val(btn.attr('data-loaithucung'));
            $('#bg-loaiphong').val(btn.attr('data-loaiphong') || '');
            $('#bg-loailong').val(String(btn.attr('data-loailong')).toLowerCase());
            $('#bg-cannangtu').val(btn.attr('data-cannangtu'));
            $('#bg-cannangden').val(btn.attr('data-cannangden'));
            $('#bg-giadv').val(btn.attr('data-giadv'));
            $('#bg-thoigianphut').val(btn.attr('data-thoigianphut'));
        });

        // ==================== ĐỔI TRẠNG THÁI ====================
        $(document).on('click', '.toggle-status', function () {
            var btn = $(this);
            var id = parseInt(btn.attr('data-id')) || 0;
            var current = btn.attr('data-status') === 'true' || btn.attr('data-status') === 'True';
            var newStatus = !current;

            if (!id) {
                abp.notify.error('Không xác định được dịch vụ.');
                return;
            }

            abp.message.confirm(
                newStatus
                    ? 'Bạn có muốn kích hoạt dịch vụ này không?'
                    : 'Bạn có muốn ngừng dịch vụ này không?',
                'Xác nhận',
                function (isConfirmed) {
                    if (!isConfirmed) return;

                    abp.ui.setBusy();

                    abp.services.app.dichVu.changeTrangThai({
                        id: id,
                        trangthai: newStatus
                    })
                    .done(function () {
                        abp.notify.success(
                            newStatus
                                ? 'Đã kích hoạt dịch vụ.'
                                : 'Đã ngừng dịch vụ.'
                        );
                        location.reload();
                    })
                    .fail(function (error) {
                        abp.notify.error(
                            error.details ||
                            error.message ||
                            'Không thể thay đổi trạng thái dịch vụ.'
                        );
                    })
                    .always(function () {
                        abp.ui.clearBusy();
                    });
                }
            );
        });
    });
</script>
}