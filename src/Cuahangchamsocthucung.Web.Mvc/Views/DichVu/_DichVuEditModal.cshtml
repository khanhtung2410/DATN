@model Cuahangchamsocthucung.DichVu.Dto.SuaDichVuDto
@using Cuahangchamsocthucung.Enum

@{
    Layout = null;
}

<div class="modal fade"
     id="DichVuEditModal"
     tabindex="-1"
     aria-hidden="true"
     data-backdrop="static">

    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content">

            @await Html.PartialAsync(
            "~/Views/Shared/Modals/_ModalHeader.cshtml",
                        new Cuahangchamsocthucung.Web.Models.Common.Modals.ModalHeaderViewModel("Sửa dịch vụ"))

            <form id="dichvu-edit-form" class="form-horizontal">

                <input type="hidden" id="dv-edit-id" value="@Model.Id" />

                <div class="modal-body">

                    <div class="mb-3 row">
                        <label class="col-md-3 col-form-label">Tên dịch vụ</label>
                        <div class="col-md-9">
                            <input type="text"
                                   id="dv-edit-tendichvu"
                                   class="form-control"
                                   value="@Model.Tendichvu"
                                   placeholder="Nhập tên dịch vụ" />
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-3 col-form-label">Loại dịch vụ</label>
                        <div class="col-md-9">
                            <select id="dv-edit-loaidichvu" class="form-control">
                                <option value="">-- Chọn loại dịch vụ --</option>
                                <option value="1">Chăm sóc</option>
                                <option value="2">Lưu trú</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-3 col-form-label">Mô tả</label>
                        <div class="col-md-9">
                            <textarea id="dv-edit-mota"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Nhập mô tả dịch vụ">@Model.Mota</textarea>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-md-3 col-form-label">Trạng thái</label>
                        <div class="col-md-9">
                            <select id="dv-edit-trangthai" class="form-control">
                                <option value="true">Đang hoạt động</option>
                                <option value="false">Ngừng hoạt động</option>
                            </select>
                        </div>
                    </div>

                    <hr />

                    <h5 class="mb-3">Bảng giá</h5>

                    <div class="table-responsive">
                        <table class="table table-bordered" id="bang-gia-edit-table">
                            <thead>
                                <tr>
                                    <th>Đối tượng</th>
                                    <th>Loại phòng</th>
                                    <th>Lông dài</th>
                                    <th>Cân nặng từ</th>
                                    <th>Cân nặng đến</th>
                                    <th>Thời gian (phút)</th>
                                    <th>Giá</th>
                                    <th style="width:80px">Xóa</th>
                                </tr>
                            </thead>
                            <tbody id="bang-gia-edit-container"></tbody>
                        </table>
                    </div>

                    <button type="button"
                            id="btn-add-banggia-edit"
                            class="btn btn-success btn-sm">
                        + Thêm mức giá
                    </button>

                </div>

                @await Html.PartialAsync(
                                "~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>

<script>
    (function ($) {
        var modal = $('#DichVuEditModal');
        if (!modal.length) return;

        var service = abp.services.app.dichVu;
        var form = modal.find('#dichvu-edit-form');

        function taoRow(data) {
            data = data || {};

            var loaiPhong = data.loaiPhong ?? data.LoaiPhong ?? '';
            var loaiLong = data.loailong === true || data.Loailong === true || data.loailong === 'true' || data.Loailong === 'true';

            return `
                <tr class="bang-gia-edit-row">
                    <td>
                        <input type="hidden" class="bg-id" value="${data.id ?? data.Id ?? 0}">
                        <select class="form-control bg-loaithucung">
                            <option value="">-- Chọn --</option>
                            <option value="Chó" ${data.loaithucung === 'Chó' || data.Loaithucung === 'Chó' ? 'selected' : ''}>Chó</option>
                            <option value="Mèo" ${data.loaithucung === 'Mèo' || data.Loaithucung === 'Mèo' ? 'selected' : ''}>Mèo</option>
                        </select>
                    </td>

                    <td>
                        <select class="form-control bg-loaiphong">
                            <option value="">-- Chọn phòng --</option>
                            <option value="Thường" ${loaiPhong === 'Thường' ? 'selected' : ''}>Phòng thường</option>
                            <option value="VIP" ${loaiPhong === 'VIP' ? 'selected' : ''}>Phòng VIP</option>
                        </select>
                    </td>

                    <td>
                        <select class="form-control bg-loailong">
                            <option value="false" ${!loaiLong ? 'selected' : ''}>Không</option>
                            <option value="true" ${loaiLong ? 'selected' : ''}>Có</option>
                        </select>
                    </td>

                    <td>
                        <input type="number"
                               min="0"
                               class="form-control bg-cannangtu"
                               value="${data.cannangtu ?? data.Cannangtu ?? 0}">
                    </td>

                    <td>
                        <input type="number"
                               min="1"
                               class="form-control bg-cannangden"
                               value="${data.cannangden ?? data.Cannangden ?? 1}">
                    </td>

                    <td>
                        <input type="number"
                               min="1"
                               max="1440"
                               class="form-control bg-thoigian"
                               value="${data.thoigianphut ?? data.ThoiGianPhut ?? 30}">
                    </td>

                    <td>
                        <input type="number"
                               min="0.01"
                               step="0.01"
                               class="form-control bg-giadv"
                               value="${data.giadv ?? data.Giadv ?? ''}">
                    </td>

                    <td class="text-center">
                        <button type="button"
                                class="btn btn-danger btn-sm btn-remove-banggia">
                            Xóa
                        </button>
                    </td>
                </tr>`;
        }

        function updateLoaiPhong() {
            var loaiDichVu = parseInt(modal.find('#dv-edit-loaidichvu').val()) || 0;
            var laLuuTru = loaiDichVu === 2;

            modal.find('.bg-loaiphong').each(function () {
                $(this).prop('disabled', !laLuuTru);

                if (!laLuuTru) {
                    $(this).val('');
                }
            });
        }

        function populateForm(data) {
            if (!data) {
                abp.notify.error('Không tìm thấy dữ liệu dịch vụ.');
                return;
            }

            modal.find('#dv-edit-id').val(data.id);
            modal.find('#dv-edit-tendichvu').val(data.tendichvu || '');
            modal.find('#dv-edit-mota').val(data.mota || '');

            var loaiDichVu = data.loaiDichVu ?? data.loaidichvu ?? data.LoaiDichVu ?? '';
            modal.find('#dv-edit-loaidichvu').val(String(loaiDichVu));

            modal.find('#dv-edit-trangthai')
                .val(data.trangthai ? 'true' : 'false');

            var container = modal.find('#bang-gia-edit-container');
            container.empty();

            if (data.bangGias && data.bangGias.length > 0) {
                $.each(data.bangGias, function (index, bg) {
                    console.log('Bảng giá ' + index + ':', bg);
                    console.log('LoaiPhong:', bg.loaiphong);
                    container.append(taoRow(bg));
                });
            } else {
                container.append(taoRow());
            }

            updateLoaiPhong();
        }

        function loadDichVu(id) {
            if (!id || id <= 0) {
                abp.notify.error('Không xác định được dịch vụ cần sửa.');
                return;
            }

            console.log('Đang load dịch vụ ID:', id);

            abp.ui.setBusy(form);

            service.getDichVu(id)
                .done(function (data) {
                    console.log('Dữ liệu dịch vụ lấy được:', data);
                    populateForm(data);
                })
                .fail(function (error) {
                    console.error('Lỗi lấy dịch vụ:', error);
                    console.error('Response:', error.responseJSON);

                    var message =
                        error.message ||
                        (error.responseJSON &&
                         error.responseJSON.error &&
                         error.responseJSON.error.message) ||
                        'Không thể lấy dữ liệu dịch vụ.';

                    abp.notify.error(message);
                })
                .always(function () {
                    abp.ui.clearBusy(form);
                });
        }

        modal.off('.dichvuEdit');

        modal.on('click.dichvuEdit', '#btn-add-banggia-edit', function (e) {
            e.preventDefault();

            modal.find('#bang-gia-edit-container')
                .append(taoRow());

            updateLoaiPhong();
        });

        modal.on('change.dichvuEdit', '#dv-edit-loaidichvu', function () {
            updateLoaiPhong();
        });

        modal.on('click.dichvuEdit', '.btn-remove-banggia', function () {
            if (modal.find('.bang-gia-edit-row').length <= 1) {
                abp.notify.warn('Phải có ít nhất một mức giá.');
                return;
            }

            $(this).closest('.bang-gia-edit-row').remove();
        });

        modal.on('click.dichvuEdit', '.save-button', function (e) {
            e.preventDefault();

            var id = parseInt(modal.find('#dv-edit-id').val()) || 0;
            var tenDichVu = (modal.find('#dv-edit-tendichvu').val() || '').trim();
            var loaiDichVu = parseInt(modal.find('#dv-edit-loaidichvu').val()) || 0;
            var bangGias = [];
            var valid = true;

            if (!id) {
                abp.notify.error('Không xác định được dịch vụ.');
                return;
            }

            if (!tenDichVu) {
                abp.notify.error('Vui lòng nhập tên dịch vụ.');
                return;
            }

            if (loaiDichVu !== 1 && loaiDichVu !== 2) {
                abp.notify.error('Vui lòng chọn loại dịch vụ.');
                return;
            }

            var rows = modal.find('.bang-gia-edit-row');

            if (!rows.length) {
                abp.notify.error('Vui lòng thêm ít nhất một mức giá.');
                return;
            }

            rows.each(function () {
                if (!valid) return;

                var row = $(this);

                var doiTuong = row.find('.bg-loaithucung').val();
                var loaiPhong = row.find('.bg-loaiphong').val() || null;
                var loaiLong = row.find('.bg-loailong').val() === 'true';
                var canNangTu = parseInt(row.find('.bg-cannangtu').val()) || 0;
                var canNangDen = parseInt(row.find('.bg-cannangden').val()) || 0;
                var thoiGian = parseInt(row.find('.bg-thoigian').val()) || 0;
                var gia = parseFloat(row.find('.bg-giadv').val()) || 0;

                if (!doiTuong) {
                    abp.notify.error('Vui lòng chọn đối tượng Chó hoặc Mèo.');
                    valid = false;
                    return;
                }

                if (loaiDichVu === 2 && !loaiPhong) {
                    abp.notify.error('Vui lòng chọn loại phòng cho dịch vụ lưu trú.');
                    valid = false;
                    return;
                }

                if (loaiDichVu === 1) {
                    loaiPhong = null;
                }

                if (canNangDen <= canNangTu) {
                    abp.notify.error('Cân nặng đến phải lớn hơn cân nặng từ.');
                    valid = false;
                    return;
                }

                if (thoiGian < 1 || thoiGian > 1440) {
                    abp.notify.error('Thời gian phải từ 1 đến 1440 phút.');
                    valid = false;
                    return;
                }

                if (gia <= 0) {
                    abp.notify.error('Giá phải lớn hơn 0.');
                    valid = false;
                    return;
                }

                var trung = bangGias.some(function (x) {
                    return x.Loaithucung === doiTuong &&
                        x.LoaiPhong === loaiPhong &&
                        x.Loailong === loaiLong &&
                        x.Cannangtu === canNangTu &&
                        x.Cannangden === canNangDen;
                });

                if (trung) {
                    abp.notify.error('Không được nhập trùng mức giá.');
                    valid = false;
                    return;
                }

                bangGias.push({
                    Id: parseInt(row.find('.bg-id').val()) || 0,
                    DichVuId: id,
                    Loaithucung: doiTuong,
                    LoaiPhong: loaiPhong,
                    Loailong: loaiLong,
                    Cannangtu: canNangTu,
                    Cannangden: canNangDen,
                    ThoiGianPhut: thoiGian,
                    Giadv: gia
                });
            });

            if (!valid) return;

            var input = {
                Id: id,
                Tendichvu: tenDichVu,
                Mota: (modal.find('#dv-edit-mota').val() || '').trim(),
                LoaiDichVu: loaiDichVu,
                Trangthai: modal.find('#dv-edit-trangthai').val() === 'true',
                BangGias: bangGias
            };

            console.log('Dữ liệu sửa:', JSON.stringify(input, null, 2));

            abp.ui.setBusy(form);

            service.update(input)
                .done(function () {
                    abp.notify.success('Cập nhật dịch vụ thành công.');
                    modal.modal('hide');
                    location.reload();
                })
                .fail(function (error) {
                    console.error('Lỗi cập nhật:', error);
                    console.error(error.responseJSON);

                    var message =
                        error.message ||
                        (error.responseJSON &&
                         error.responseJSON.error &&
                         error.responseJSON.error.message) ||
                        'Không thể cập nhật dịch vụ.';

                    abp.notify.error(message);
                })
                .always(function () {
                    abp.ui.clearBusy(form);
                });
        });

        // Khi modal mở -> lấy ID từ data-id -> gọi API
        modal.on('shown.bs.modal.dichvuEdit', function () {
            var id = parseInt(modal.attr('data-id')) ||
                     parseInt(modal.data('id')) ||
                     parseInt(modal.find('#dv-edit-id').val()) ||
                     0;

            console.log('Modal mở - ID dịch vụ:', id);

            if (id > 0) {
                loadDichVu(id);
            } else {
                abp.notify.error('Không xác định được ID dịch vụ.');
            }
        });

    })(jQuery);
</script>