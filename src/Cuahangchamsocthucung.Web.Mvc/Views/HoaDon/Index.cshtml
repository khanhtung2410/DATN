@model Cuahangchamsocthucung.Web.Models.HoaDon.HoaDonListViewModel

@{
    ViewBag.Title = "Danh sách hóa đơn";
    ViewBag.CurrentPageName = "Hóa đơn";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Hóa đơn</h1>
            </div>
            <div class="col-sm-6 text-right">
                <button type="button" class="btn bg-blue" onclick="moDanhSachTaoHoaDon()">
                    <i class="fa fa-plus-square"></i> Tạo hóa đơn
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-file-invoice mr-2"></i>
                    Danh sách hóa đơn
                </h3>
            </div>

            <div class="card-body">
                <form method="get" asp-action="Index" class="mb-4">
                    <div class="row">
                        <div class="col-md-4">
                            <div class="form-group mb-0">
                                <label>Khách hàng</label>
                                <input type="text" name="tenKhachHang" class="form-control"
                                       placeholder="Nhập tên khách hàng..."
                                       value="@Model.TenKhachHang" />
                            </div>
                        </div>

                        <div class="col-md-3">
                            <div class="form-group mb-0">
                                <label>Trạng thái</label>
                                <select name="trangThai" class="form-control">
                                    <option value="">-- Tất cả trạng thái --</option>
                                    <option value="ChuaThanhToan" selected="@(Model.TrangThai == "ChuaThanhToan")">Chưa thanh toán</option>
                                    <option value="DaThanhToan" selected="@(Model.TrangThai == "DaThanhToan")">Đã thanh toán</option>
                                    <option value="DaHuy" selected="@(Model.TrangThai == "DaHuy")">Đã hủy</option>
                                </select>
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group mb-0">
                                <label>Từ ngày</label>
                                <input type="date" name="tuNgay" class="form-control"
                                       value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="form-group mb-0">
                                <label>Đến ngày</label>
                                <input type="date" name="denNgay" class="form-control"
                                       value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))" />
                            </div>
                        </div>

                        <div class="col-md-1 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100" title="Lọc">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>

                    <div class="mt-3">
                        <a asp-action="Index" class="btn btn-secondary btn-sm">
                            <i class="fas fa-redo mr-1"></i>Xóa lọc
                        </a>
                    </div>
                </form>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th style="width:50px">#</th>
                                <th>Mã hóa đơn</th>
                                <th>Khách hàng</th>
                                <th>Nhân viên</th>
                                <th>Ngày lập</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                                <th class="text-center" style="width:280px">Hành động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.HoaDons.Any())
                            {
                                var stt = (Model.CurrentPage - 1) * 10 + 1;

                                foreach (var item in Model.HoaDons)
                                {
                                    <tr>
                                        <td>@stt</td>
                                        <td><strong>#@item.Id</strong></td>
                                        <td>@(string.IsNullOrEmpty(item.TenKhachHang) ? "Không xác định" : item.TenKhachHang)</td>
                                        <td>@(string.IsNullOrEmpty(item.TenNhanVien) ? "Không xác định" : item.TenNhanVien)</td>
                                        <td>@item.NgayLap.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td><strong>@item.TongTien.ToString("N0") đ</strong></td>
                                        <td>
                                            @if (item.TrangThai == "DaThanhToan")
                                            {
                                                <span class="badge badge-success">Đã thanh toán</span>
                                            }
                                            else if (item.TrangThai == "DaHuy")
                                            {
                                                <span class="badge badge-danger">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-warning">Chưa thanh toán</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="d-flex justify-content-center" style="gap:5px;">

                                                <button type="button"
                                                        class="btn btn-sm btn-info"
                                                        onclick="xemChiTiet(@item.Id)">
                                                    <i class="fas fa-eye"></i> Chi tiết
                                                </button>

                                                @if (item.TrangThai == "ChuaThanhToan")
                                                {
                                                    <a asp-action="ThanhToanQr" asp-route-id="@item.Id" target="_blank" class="btn btn-sm btn-success">
                                                        <i class="fas fa-qrcode"></i> QR
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-primary" onclick="xacNhanThanhToan(@item.Id)">
                                                        <i class="fas fa-check-circle"></i> Thanh toán
                                                    </button>
                                                    <button type="button" class="btn btn-sm btn-danger" onclick="huyHoaDon(@item.Id)">
                                                        <i class="fas fa-times-circle"></i> Hủy
                                                    </button>
                                                }

                                                @if (item.TrangThai == "DaThanhToan")
                                                {
                                                    <a asp-action="InHoaDon"
                                                       asp-route-id="@item.Id"
                                                       target="_blank"
                                                       class="btn btn-sm btn-success">
                                                        <i class="fas fa-print"></i> In
                                                    </a>
                                                }

                                            </div>
                                        </td>
                                    </tr>

                                    stt++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8" class="text-center text-muted py-4">
                                        <i class="fas fa-file-invoice fa-2x mb-2"></i>
                                        <div>Không tìm thấy hóa đơn phù hợp.</div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.TotalPages > 1)
                {
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <div class="text-muted">
                            Trang @Model.CurrentPage / @Model.TotalPages
                        </div>

                        <nav>
                            <ul class="pagination mb-0">

                                <!-- TRANG TRƯỚC -->
                                <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                                    @if (Model.CurrentPage > 1)
                                    {
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@(Model.CurrentPage - 1)"
                                           asp-route-tenKhachHang="@Model.TenKhachHang"
                                           asp-route-trangThai="@Model.TrangThai"
                                           asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                                           asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")">
                                            <i class="fas fa-chevron-left"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link">
                                            <i class="fas fa-chevron-left"></i>
                                        </span>
                                    }
                                </li>

                                @{
                                    int currentPage = Model.CurrentPage;
                                    int totalPages = Model.TotalPages;

                                    int startPage = Math.Max(1, currentPage - 2);
                                    int endPage = Math.Min(totalPages, currentPage + 2);

                                    // Luôn hiển thị 5 trang nếu có đủ
                                    if (currentPage <= 3)
                                    {
                                        startPage = 1;
                                        endPage = Math.Min(5, totalPages);
                                    }
                                    else if (currentPage >= totalPages - 2)
                                    {
                                        startPage = Math.Max(1, totalPages - 4);
                                        endPage = totalPages;
                                    }
                                }

                                <!-- TRANG 1 -->
                                @if (startPage > 1)
                                {
                                    <li class="page-item @(currentPage == 1 ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="1"
                                           asp-route-tenKhachHang="@Model.TenKhachHang"
                                           asp-route-trangThai="@Model.TrangThai"
                                           asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                                           asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")">
                                            1
                                        </a>
                                    </li>

                                    @if (startPage > 2)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }
                                }

                                <!-- CÁC TRANG XUNG QUANH TRANG HIỆN TẠI -->
                                @for (var i = startPage; i <= endPage; i++)
                                {
                                    <li class="page-item @(i == currentPage ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@i"
                                           asp-route-tenKhachHang="@Model.TenKhachHang"
                                           asp-route-trangThai="@Model.TrangThai"
                                           asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                                           asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")">
                                            @i
                                        </a>
                                    </li>
                                }

                                <!-- TRANG CUỐI -->
                                @if (endPage < totalPages)
                                {
                                    @if (endPage < totalPages - 1)
                                    {
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    }

                                    <li class="page-item @(currentPage == totalPages ? "active" : "")">
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@totalPages"
                                           asp-route-tenKhachHang="@Model.TenKhachHang"
                                           asp-route-trangThai="@Model.TrangThai"
                                           asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                                           asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")">
                                            @totalPages
                                        </a>
                                    </li>
                                }

                                <!-- TRANG SAU -->
                                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                    @if (currentPage < totalPages)
                                    {
                                        <a class="page-link"
                                           asp-action="Index"
                                           asp-route-page="@(currentPage + 1)"
                                           asp-route-tenKhachHang="@Model.TenKhachHang"
                                           asp-route-trangThai="@Model.TrangThai"
                                           asp-route-tuNgay="@Model.TuNgay?.ToString("yyyy-MM-dd")"
                                           asp-route-denNgay="@Model.DenNgay?.ToString("yyyy-MM-dd")">
                                            <i class="fas fa-chevron-right"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="page-link">
                                            <i class="fas fa-chevron-right"></i>
                                        </span>
                                    }
                                </li>

                            </ul>
                        </nav>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- MODAL CHI TIẾT HÓA ĐƠN -->
<div class="modal fade" id="HoaDonDetailModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-file-invoice mr-2"></i>Chi tiết hóa đơn
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="HoaDonDetailContent"></div>
        </div>
    </div>
</div>

<!-- MODAL TẠO HÓA ĐƠN -->
<div class="modal fade" id="TaoHoaDonModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-xl" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-file-invoice-dollar mr-2"></i>
                    Chọn lịch chăm sóc để tạo hóa đơn
                </h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="TaoHoaDonContent">
                <div class="text-center py-4">
                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                    <p class="mt-2">Đang tải dữ liệu...</p>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        (function () {
            "use strict";

            function escapeHtml(value) {
                if (value === null || value === undefined) return "";
                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function formatNotificationDate(value) {
                if (!value) return "";

                var date = new Date(value);

                if (isNaN(date.getTime())) {
                    return escapeHtml(value);
                }

                return date.toLocaleString("vi-VN", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit"
                });
            }

            function formatCurrency(value) {
                var number = Number(value);

                if (isNaN(number)) {
                    number = 0;
                }

                return number.toLocaleString("vi-VN", {
                    maximumFractionDigits: 0
                });
            }

            window.moDanhSachTaoHoaDon = function () {
                $("#TaoHoaDonContent").html(`
                    <div class="text-center py-4">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>
                        <p class="mt-2">Đang tải lịch chăm sóc...</p>
                    </div>
                `);

                $("#TaoHoaDonModal").modal("show");

                abp.services.app.hoaDon.layLichChamSocChuaCoHoaDon()
                    .done(function (result) {
                        console.log("Danh sách lịch chưa có hóa đơn:", result);

                        var items = result && result.result
                            ? result.result
                            : (result || []);

                        renderDanhSachTaoHoaDon(items);
                    })
                    .fail(function (error) {
                        console.error("Lỗi tải danh sách lịch:", error);

                        var message = "Không thể tải danh sách lịch chăm sóc.";

                        if (error && error.error && error.error.message) {
                            message = error.error.message;
                        } else if (error && error.message) {
                            message = error.message;
                        }

                        $("#TaoHoaDonContent").html(`
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-circle mr-1"></i>
                                ${escapeHtml(message)}
                            </div>
                        `);
                    });
            };

            window.renderDanhSachTaoHoaDon = function (items) {
                if (!Array.isArray(items)) {
                    items = [];
                }

                if (!items.length) {
                    $("#TaoHoaDonContent").html(`
                        <div class="text-center text-muted py-5">
                            <i class="fas fa-calendar-check fa-3x mb-3"></i>
                            <h5>Không có lịch chăm sóc nào</h5>
                            <p class="mb-0">
                                Hiện không có lịch đã hoàn thành và chưa lập hóa đơn.
                            </p>
                        </div>
                    `);
                    return;
                }

                var html = `
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th style="width:50px">#</th>
                                    <th>Khách hàng</th>
                                    <th>Thú cưng</th>
                                    <th>Dịch vụ</th>
                                    <th>Nhân viên</th>
                                    <th>Thời gian</th>
                                    <th>Đơn giá</th>
                                    <th style="width:100px">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                `;

                $.each(items, function (index, item) {
                    html += `
                        <tr>
                            <td>${index + 1}</td>
                            <td>
                                <strong>${escapeHtml(item.tenKhachHang)}</strong>
                                <br>
                                <small class="text-muted">
                                    ${escapeHtml(item.sdtKhachHang || "")}
                                </small>
                            </td>
                            <td>${escapeHtml(item.tenThuCung)}</td>
                            <td>${escapeHtml(item.tenDichVu)}</td>
                            <td>${escapeHtml(item.tenNhanVien || "Chưa xác định")}</td>
                            <td>${formatNotificationDate(item.thoiGian)}</td>
                            <td>
                                <strong>${formatCurrency(item.donGia)} đ</strong>
                            </td>
                            <td class="text-center">
                                <button type="button"
                                        class="btn btn-sm btn-primary"
                                        onclick="taoHoaDon(${item.id})">
                                    <i class="fas fa-file-invoice"></i> Tạo
                                </button>
                            </td>
                        </tr>
                    `;
                });

                html += `
                            </tbody>
                        </table>
                    </div>
                `;

                $("#TaoHoaDonContent").html(html);
            };
                    window.xacNhanThanhToan = function (id) {
            if (!id || id <= 0) {
                abp.message.error("Mã hóa đơn không hợp lệ.");
                return;
            }

            abp.message.confirm(
                "Bạn có chắc chắn muốn xác nhận thanh toán hóa đơn này?",
                "Xác nhận thanh toán",
                function (isConfirmed) {
                    if (!isConfirmed) return;

                    abp.ui.setBusy("body");

                    abp.services.app.hoaDon.xacNhanThanhToan(id)
                        .done(function () {
                            abp.notify.success("Thanh toán hóa đơn thành công.");

                            setTimeout(function () {
                                location.reload();
                            }, 500);
                        })
                        .fail(function (error) {
                            console.error(error);

                            var message = "Không thể xác nhận thanh toán.";

                            if (error && error.error && error.error.message) {
                                message = error.error.message;
                            }

                            abp.message.error(message);
                        })
                        .always(function () {
                            abp.ui.clearBusy("body");
                        });
                }
            );
        };
            window.taoHoaDon = function (lichChamSocId) {
                if (!lichChamSocId || lichChamSocId <= 0) {
                    abp.message.error("Mã lịch chăm sóc không hợp lệ.");
                    return;
                }

                abp.message.confirm(
                    "Bạn có chắc muốn tạo hóa đơn cho lịch chăm sóc này?",
                    "Xác nhận tạo hóa đơn",
                    function (isConfirmed) {
                        if (!isConfirmed) return;

                        abp.ui.setBusy("#TaoHoaDonContent");

                        abp.services.app.hoaDon.themHoaDon({
                            lichChamSocId: lichChamSocId
                        })
                        .done(function (result) {
                            console.log("Tạo hóa đơn thành công:", result);

                            abp.notify.success("Tạo hóa đơn thành công.");

                            $("#TaoHoaDonModal").modal("hide");

                            setTimeout(function () {
                                location.reload();
                            }, 500);
                        })
                        .fail(function (error) {
                            console.error("Lỗi tạo hóa đơn:", error);

                            var message = "Không thể tạo hóa đơn.";

                            if (error && error.error && error.error.message) {
                                message = error.error.message;
                            } else if (error && error.message) {
                                message = error.message;
                            }

                            abp.message.error(message);
                        })
                        .always(function () {
                            abp.ui.clearBusy("#TaoHoaDonContent");
                        });
                    }
                );
            };

            window.xemChiTiet = function (id) {
                if (!id || id <= 0) {
                    abp.message.error("Mã hóa đơn không hợp lệ.");
                    return;
                }

                $("#HoaDonDetailContent").html(`
                    <div class="text-center py-4">
                        <i class="fas fa-spinner fa-spin fa-2x"></i>
                        <p class="mt-2">Đang tải dữ liệu...</p>
                    </div>
                `);

                $("#HoaDonDetailModal").modal("show");

                $.get('@Url.Action("ChiTiet", "HoaDon")', { id: id })
                    .done(function (html) {
                        $("#HoaDonDetailContent").html(html);
                    })
                    .fail(function (error) {
                        console.error("Lỗi tải chi tiết hóa đơn:", error);

                        $("#HoaDonDetailContent").html(`
                            <div class="alert alert-danger">
                                <i class="fas fa-exclamation-circle mr-1"></i>
                                Không thể tải chi tiết hóa đơn.
                            </div>
                        `);
                    });
            };
        })();
    </script>
}