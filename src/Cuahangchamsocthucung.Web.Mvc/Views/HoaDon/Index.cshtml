@model Cuahangchamsocthucung.Web.Models.HoaDon.HoaDonListViewModel
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Danh sách hóa đơn";
    ViewBag.CurrentPageName = "Hóa đơn";
}
<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Hóa đơn</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="javascript:;" data-toggle="modal" data-target="#CreateModal" class="btn bg-blue">
                    <i class="fa fa-plus-square"></i> Thêm
                </a>
            </div>
        </div>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="HoaDonTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Mã hóa đơn</th>
                                        <th>Khách hàng</th>
                                        <th>Ngày</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th style="width: 200px">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.HoaDons != null)
                                    {
                                        foreach (var item in Model.HoaDons)
                                        {
                                            <tr>
                                                <td></td>
                                                <td>@item.Id</td>
                                                <td>@item.KhachHangId</td>
                                                <td>@item.NgayLap.ToString("yyyy-MM-dd")</td>
                                                <td>@item.TongTien</td>
                                                <td>@item.TrangThai</td>
                                                <td>
                                                    <button class="btn btn-sm btn-secondary edit-hoadon" data-id="@item.Id" data-toggle="modal" data-target="#HoaDonEditModal">Sửa</button>
                                                    <button class="btn btn-sm btn-warning toggle-status" data-id="@item.Id" data-status="@item.TrangThai">@(item.TrangThai == "Đã thanh toán" ? "Hoàn/Đóng" : "Đánh dấu")</button>
                                                    <button class="btn btn-sm btn-danger delete-hoadon" data-id="@item.Id">Xóa</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {

}

@await Html.PartialAsync("~/Views/HoaDon/_CreateModal.cshtml", Model)

<div class="modal fade" id="HoaDonEditModal" tabindex="-1" role="dialog" aria-labelledby="HoaDonEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>
