@model Cuahangchamsocthucung.Web.Models.HoaDon.HoaDonListViewModel
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Danh sách hóa đơn";
    ViewBag.CurrentPageName = "Hóa đơn";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Hóa đơn</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">

                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-file-invoice mr-2"></i>
                            Danh sách hóa đơn
                        </h3>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="HoaDonTable"
                                   class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width:50px"></th>
                                        <th>Mã hóa đơn</th>
                                        <th>Khách hàng</th>
                                        <th>Nhân viên</th>
                                        <th>Ngày lập</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th style="width:220px">Hành động</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (Model?.HoaDons != null && Model.HoaDons.Any())
                                    {
                                        foreach (var item in Model.HoaDons)
                                        {
                                            <tr>
                                                <td></td>

                                                <td>
                                                    <strong>#@item.Id</strong>
                                                </td>

                                                <td>
                                                    @item.KhachHangId
                                                </td>

                                                <td>
                                                    @item.NhanVienId
                                                </td>

                                                <td>
                                                    @item.NgayLap.ToString("dd/MM/yyyy HH:mm")
                                                </td>

                                                <td>
                                                    <strong>
                                                        @item.TongTien.ToString("N0") đ
                                                    </strong>
                                                </td>

                                                <td>
                                                    @if (item.TrangThai == "DaThanhToan" ||
                                                                                                item.TrangThai == "Đã thanh toán")
                                                    {
                                                        <span class="badge badge-success">
                                                            Đã thanh toán
                                                        </span>
                                                    }
                                                    else if (item.TrangThai == "DaHuy" ||
                                                    item.TrangThai == "Đã hủy")
                                                    {
                                                        <span class="badge badge-danger">
                                                            Đã hủy
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge badge-warning">
                                                            Chưa thanh toán
                                                        </span>
                                                    }
                                                </td>

                                                <td>
                                                    <div class="btn-group">

                                                        <button type="button"
                                                                class="btn btn-sm btn-info xem-chitiet-hoadon"
                                                                data-id="@item.Id">
                                                            <i class="fas fa-eye"></i>
                                                            Chi tiết
                                                        </button>

                                                        @if (item.TrangThai != "DaThanhToan" &&
                                                                                                        item.TrangThai != "Đã thanh toán" &&
                                                                                                        item.TrangThai != "DaHuy" &&
                                                                                                        item.TrangThai != "Đã hủy")
                                                        {
                                                            <button type="button"
                                                                    class="btn btn-sm btn-danger huy-hoadon"
                                                                    data-id="@item.Id">
                                                                <i class="fas fa-ban"></i>
                                                                Hủy
                                                            </button>
                                                        }

                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="8"
                                                class="text-center text-muted py-4">
                                                <i class="fas fa-file-invoice fa-2x mb-2"></i>
                                                <br />
                                                Chưa có hóa đơn.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

<!-- MODAL XEM CHI TIẾT -->
<div class="modal fade"
     id="HoaDonDetailModal"
     tabindex="-1"
     role="dialog"
     aria-labelledby="HoaDonDetailModalLabel"
     data-backdrop="static">

    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="HoaDonDetailModalLabel">
                    <i class="fas fa-file-invoice mr-2"></i>
                    Chi tiết hóa đơn
                </h5>

                <button type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Đóng">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body" id="HoaDonDetailContent">
                <div class="text-center py-4">
                    <i class="fas fa-spinner fa-spin fa-2x"></i>
                    <p class="mt-2 mb-0">
                        Đang tải dữ liệu...
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/view-resources/Views/HoaDon/Index.js"
            asp-append-version="true"></script>
}
