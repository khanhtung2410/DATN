@model Cuahangchamsocthucung.HoaDon.Dto.ThanhToanQrDto

@{
    ViewBag.Title = "Thanh toán QR";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Thanh toán QR - Hóa đơn #@Model.HoaDonId</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css" />
    <style>
        body {
            background: #f4f6f9;
            font-family: Arial, sans-serif;
        }

        .qr-wrapper {
            max-width: 700px;
            margin: 40px auto;
        }

        .qr-card {
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,.1);
            overflow: hidden;
        }

        .qr-header {
            background: #007bff;
            color: #fff;
            padding: 20px;
            text-align: center;
        }

            .qr-header h3 {
                margin: 0;
                font-weight: 600;
            }

        .qr-body {
            padding: 30px;
        }

        .qr-image {
            width: 330px;
            max-width: 100%;
            border: 1px solid #ddd;
            border-radius: 8px;
            padding: 8px;
            background: #fff;
        }

        .payment-info {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            padding: 18px;
            margin-top: 25px;
        }

        .payment-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
        }

            .payment-row:last-child {
                border-bottom: none;
            }

        .amount {
            color: #dc3545;
            font-size: 24px;
            font-weight: bold;
        }

        .note {
            background: #eaf4ff;
            border-radius: 8px;
            padding: 15px;
            margin-top: 20px;
        }

        .btn-print {
            margin-top: 20px;
        }
        @@media print {
            body

        {
            background: #fff;
        }

        .qr-wrapper {
            margin: 0 auto;
        }

        .qr-card {
            box-shadow: none;
        }

        .btn-print {
            display: none !important;
        }

        }
    </style>
</head>
<body>
    <div class="qr-wrapper">
        <div class="qr-card">
            <div class="qr-header">
                <h3><i class="fas fa-qrcode mr-2"></i>THANH TOÁN QR</h3>
                <div class="mt-1">Hóa đơn #@Model.HoaDonId</div>
            </div>

            <div class="qr-body text-center">
                <h5 class="mb-3">Quét mã QR để thanh toán</h5>

                <img src="@Model.UrlQr"
                     alt="QR thanh toán"
                     class="qr-image" />

                <div class="payment-info text-left">
                    <div class="payment-row">
                        <span>Hóa đơn</span>
                        <strong>#@Model.HoaDonId</strong>
                    </div>

                    <div class="payment-row">
                        <span>Số tiền</span>
                        <span class="amount">@Model.SoTien.ToString("N0") đ</span>
                    </div>

                    <div class="payment-row">
                        <span>Nội dung chuyển khoản</span>
                        <strong>@Model.NoiDung</strong>
                    </div>
                </div>

                <div class="note text-left">
                    <i class="fas fa-info-circle text-primary mr-1"></i>
                    Vui lòng kiểm tra đúng <strong>số tiền</strong> và
                    <strong>nội dung chuyển khoản</strong> trước khi thanh toán.
                </div>

                <button type="button" class="btn btn-primary btn-print" onclick="window.print()">
                    <i class="fas fa-print mr-1"></i> In mã QR
                </button>

                <button type="button" class="btn btn-secondary btn-print" onclick="window.close()">
                    <i class="fas fa-times mr-1"></i> Đóng
                </button>
            </div>
        </div>
    </div>
</body>
</html>