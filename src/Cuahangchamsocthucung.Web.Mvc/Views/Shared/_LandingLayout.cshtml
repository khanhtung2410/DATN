@using Cuahangchamsocthucung.Sessions.Dto
@using Abp.Web.Security.AntiForgery
@inject Cuahangchamsocthucung.Sessions.ISessionAppService SessionAppService
@inject IAbpAntiForgeryManager AbpAntiForgeryManager
@{
    Layout = null;
    AbpAntiForgeryManager.SetCookie(Context);
    GetCurrentLoginInformationsOutput loginInfo = null;
    string fullName = null;

    if (User.Identity?.IsAuthenticated == true)
    {
        try
        {
            loginInfo = await SessionAppService.GetCurrentLoginInformations();
        }
        catch
        {
            loginInfo = null;
        }

        if (loginInfo?.User != null)
        {
            var name = loginInfo.User.Name?.Trim();
            var surname = loginInfo.User.Surname?.Trim();
            fullName = !string.IsNullOrEmpty(name) || !string.IsNullOrEmpty(surname)
                ? $"{name} {surname}".Trim()
                : loginInfo.User.UserName;
        }
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Cửa Hàng Chăm Sóc Thú Cưng</title>
    <link rel="icon" type="image/png" href="~/img/logo.png" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <style>
        .account-btn {
            background: #fff;
            border: 1px solid #e5e5e5;
            transition: .2s;
        }

            .account-btn:hover {
                background: #fff8e1;
                border-color: #ffc107;
            }

        .notification-btn {
            width: 44px;
            height: 44px;
            padding: 0;
        }

        .notification-badge {
            font-size: .65rem;
        }

        .vip-card {
            background: linear-gradient(135deg,#fff8e1,#fff3cd);
            border: 1px solid #ffe69c;
        }

        .vip-icon {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: #ffc107;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }
    </style>
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold d-flex align-items-center" asp-controller="Landing" asp-action="Index">
                <img src="~/img/logo.png" asp-append-version="true" alt="Logo" class="rounded-circle me-2" style="width:45px;height:45px;object-fit:cover;" />
                <span>Cửa Hàng Chăm Sóc Thú Cưng</span>
            </a>

            <div class="d-flex align-items-center ms-auto">
                <a class="btn btn-outline-secondary rounded-pill px-4 me-2" asp-controller="Landing" asp-action="Index">Trang chủ</a>
                <a class="btn btn-outline-secondary rounded-pill px-4 me-2" asp-controller="Landing" asp-action="KhachSan">Khách sạn</a>
                <a class="btn btn-outline-secondary rounded-pill px-4 me-2" asp-controller="Landing" asp-action="TamSpa">Tắm Spa</a>
                <a class="btn btn-outline-secondary rounded-pill px-4 me-3" asp-controller="Landing" asp-action="CatTiaLong">Cắt tỉa lông</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown me-2">
                        <button class="btn btn-light border rounded-circle notification-btn position-relative"
                                type="button"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            🔔
                            <span id="notificationBadge"
                                  class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger notification-badge d-none">0</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow" style="width:330px;">
                            <li>
                                <h6 class="dropdown-header">🔔 Thông báo</h6>
                            </li>
                            <li>
                                <div class="px-3 py-3 text-muted text-center" id="notificationPreview">
                                    <div class="spinner-border spinner-border-sm text-warning"></div>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-center text-warning fw-semibold"
                                   asp-controller="Landing"
                                   asp-action="ThongBao">
                                    Xem tất cả thông báo
                                </a>
                            </li>
                        </ul>
                    </div>

                    <div class="dropdown">
                        <button class="btn account-btn rounded-pill px-4 dropdown-toggle"
                                type="button"
                                id="userDropdown"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            👤 Xin chào, <strong>@(fullName ?? "Người dùng")</strong>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userDropdown">
                            <li>
                                <a class="dropdown-item" asp-controller="Landing" asp-action="ThongTinCaNhan">
                                    👤 Thông tin cá nhân
                                </a>
                            </li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Home" asp-action="Index">
                                        ⚙️ Trang quản trị
                                    </a>
                                </li>
                            }
                            <li>
                                <a class="dropdown-item" asp-controller="Landing" asp-action="ThongBao">
                                    🔔 Thông báo
                                    <span id="notificationMenuBadge" class="badge bg-danger rounded-pill d-none">0</span>
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item" asp-controller="Landing" asp-action="ThuCung">
                                    🐾 Quản lý thú cưng
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" asp-controller="Landing" asp-action="LichChamSoc">
                                    🗓️ Lịch chăm sóc
                                </a>
                            </li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                    🚪 Đăng xuất
                                </a>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-warning rounded-pill px-4 me-2"
                        asp-controller="Account"
                        asp-action="Register">
                        Đăng ký
                    </a>
                    <a class="btn btn-warning rounded-pill px-4"
                       asp-controller="Account"
                       asp-action="Login">
                        Đăng nhập
                    </a>
                }
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="mt-5 bg-dark text-white">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <h5>🐾 Cửa Hàng Chăm Sóc Thú Cưng</h5>
                    <p class="mb-0">Dịch vụ chăm sóc, làm đẹp và lưu trú cho thú cưng.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0">© @DateTime.Now.Year Cửa Hàng Chăm Sóc Thú Cưng</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/libs/abp-web-resources/Abp/Framework/scripts/abp.js"></script>
    <script src="~/libs/abp-web-resources/Abp/Framework/scripts/libs/abp.jquery.js"></script>
    <script src="~/AbpScripts/GetScripts"></script>
    <script src="~/AbpServiceProxies/GetAll"></script>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            $(function () {
                if (abp.services.app.thongBao) {
                    loadNotificationPreview();
                }
            });

            function loadNotificationPreview() {
                abp.services.app.thongBao.getCuaToi()
                    .done(function (result) {
                        var items = result.result || result || [];
                        renderNotificationPreview(items);
                        updateNotificationBadge(items);
                    })
                    .fail(function (error) {
                        console.error('Không thể tải thông báo:', error);
                        $('#notificationPreview').html(
                            '<div class="text-center text-danger py-2">Không thể tải thông báo.</div>'
                        );
                    });
            }

            function renderNotificationPreview(items) {
                if (!items.length) {
                    $('#notificationPreview').html(
                        '<div class="text-center text-muted py-2">Chưa có thông báo.</div>'
                    );
                    return;
                }

                var html = '';
                var max = Math.min(items.length, 3);

                for (var i = 0; i < max; i++) {
                    var item = items[i];
                    var isRead = Number(item.state) === 1;

                    html += `
                        <div class="border-bottom py-2 ${!isRead ? 'bg-light' : ''}">
                            <div class="fw-semibold small">
                                ${getNotificationTitle(item.notificationName)}
                            </div>
                            <div class="text-muted small mt-1">
                                ${escapeHtml(item.message)}
                            </div>
                            <div class="text-muted" style="font-size:11px;">
                                ${formatNotificationDate(item.creationTime)}
                            </div>
                        </div>`;
                }

                $('#notificationPreview').html(html);
            }

            function updateNotificationBadge(items) {
                var count = items.filter(function (x) {
                    return Number(x.state) === 0;
                }).length;

                var $badge = $('#notificationBadge');
                var $menuBadge = $('#notificationMenuBadge');

                if (count > 0) {
                    $badge.text(count).removeClass('d-none');
                    $menuBadge.text(count).removeClass('d-none');
                } else {
                    $badge.addClass('d-none');
                    $menuBadge.addClass('d-none');
                }
            }

            function getNotificationTitle(name) {
                name = name || '';

                if (name.indexOf('LichChamSoc.DaXacNhan') >= 0)
                    return '✅ Lịch chăm sóc đã được xác nhận';

                if (name.indexOf('LichChamSoc.BiTuChoi') >= 0)
                    return '❌ Lịch chăm sóc bị từ chối';

                if (name.indexOf('LichChamSoc.SapDenGio') >= 0)
                    return '⏰ Sắp đến giờ chăm sóc';

                if (name.indexOf('LichChamSoc.DaHoanThanh') >= 0)
                    return '🎉 Lịch chăm sóc đã hoàn thành';

                if (name.indexOf('KhachHang.DatVip') >= 0)
                    return '👑 Bạn đã đạt cấp VIP mới';

                if (name.indexOf('Vip.ThayDoiChinhSach') >= 0)
                    return '📢 Chính sách VIP đã thay đổi';

                return '🔔 Thông báo';
            }

            function formatNotificationDate(value) {
                if (!value)
                    return '';

                var date = new Date(value);

                if (isNaN(date.getTime()))
                    return '';

                return date.toLocaleDateString('vi-VN') + ' ' +
                    date.toLocaleTimeString('vi-VN', {
                        hour: '2-digit',
                        minute: '2-digit'
                    });
            }

            function escapeHtml(value) {
                return $('<div>').text(value == null ? '' : value).html();
            }
        </script>
    }

    @RenderSection("Scripts", required: false)
</body>
</html>