@using Cuahangchamsocthucung.Web.Startup

@{
    ViewBag.Title = "Home";
}

@section scripts
{
    <environment names="Development">
        <script src="~/libs/chartjs/dist/Chart.js" asp-append-version="true"></script>
        <script src="~/view-resources/Views/Home/Index.js" asp-append-version="true"></script>
    </environment>

    <environment names="Staging,Production">
        <script src="~/view-resources/Views/_Bundles/home-index.min.js" asp-append-version="true"></script>
    </environment>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Báo cáo tổng quan</h1>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">

        <!-- ========================= -->
        <!-- BỘ LỌC THÁNG -->
        <!-- ========================= -->

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="row">

                    <div class="col-md-3">
                        <label for="thang">Tháng</label>
                        <select id="thang" class="form-control">
                            <option value="1">Tháng 1</option>
                            <option value="2">Tháng 2</option>
                            <option value="3">Tháng 3</option>
                            <option value="4">Tháng 4</option>
                            <option value="5">Tháng 5</option>
                            <option value="6">Tháng 6</option>
                            <option value="7">Tháng 7</option>
                            <option value="8">Tháng 8</option>
                            <option value="9">Tháng 9</option>
                            <option value="10">Tháng 10</option>
                            <option value="11">Tháng 11</option>
                            <option value="12">Tháng 12</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label for="nam">Năm</label>
                        <select id="nam" class="form-control"></select>
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button id="btnBaoCao" class="btn btn-primary">
                            <i class="fas fa-search mr-1"></i>
                            Xem báo cáo
                        </button>
                    </div>

                </div>
            </div>
        </div>

        <!-- ========================= -->
        <!-- KPI -->
        <!-- ========================= -->

        <div class="row">

            <!-- DOANH THU -->

            <div class="col-lg-3 col-6">
                <div class="small-box bg-success">
                    <div class="inner">
                        <h3 id="doanhThu">0 ₫</h3>
                        <p>Doanh thu đã thanh toán</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-money-bill-wave"></i>
                    </div>
                </div>
            </div>

            <!-- CHI PHÍ LƯƠNG -->

            <div class="col-lg-3 col-6">
                <div class="small-box bg-danger">
                    <div class="inner">
                        <h3 id="chiPhiLuong">0 ₫</h3>
                        <p>Chi phí lương</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-wallet"></i>
                    </div>
                </div>
            </div>

            <!-- LỢI NHUẬN -->

            <div class="col-lg-3 col-6">
                <div class="small-box bg-info">
                    <div class="inner">
                        <h3 id="loiNhuan">0 ₫</h3>
                        <p>Lợi nhuận</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-chart-line"></i>
                    </div>
                </div>
            </div>

            <!-- CHƯA THANH TOÁN -->

            <div class="col-lg-3 col-6">
                <div class="small-box bg-warning">
                    <div class="inner">
                        <h3 id="doanhThuChuaThanhToan">0 ₫</h3>
                        <p>Chưa thanh toán</p>
                    </div>

                    <div class="icon">
                        <i class="fas fa-clock"></i>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================= -->
        <!-- THỐNG KÊ -->
        <!-- ========================= -->

        <div class="row">

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-info">
                        <i class="fas fa-calendar-check"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Lịch chăm sóc
                        </span>

                        <span class="info-box-number"
                              id="tongLichChamSoc">
                            0
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-success">
                        <i class="fas fa-check"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Hoàn thành
                        </span>

                        <span class="info-box-number"
                              id="lichHoanThanh">
                            0
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-primary">
                        <i class="fas fa-play"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Đang diễn ra
                        </span>

                        <span class="info-box-number"
                              id="lichDangDienRa">
                            0
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-warning">
                        <i class="fas fa-hourglass-half"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Chờ xác nhận
                        </span>

                        <span class="info-box-number"
                              id="lichChoXacNhan">
                            0
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================= -->
        <!-- THỐNG KÊ 2 -->
        <!-- ========================= -->

        <div class="row">

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-primary">
                        <i class="fas fa-user-check"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Đã xác nhận
                        </span>

                        <span class="info-box-number"
                              id="lichDaXacNhan">
                            0
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-warning">
                        <i class="fas fa-times"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Đã hủy
                        </span>

                        <span class="info-box-number"
                              id="lichDaHuy">
                            0
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-danger">
                        <i class="fas fa-ban"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Bị từ chối
                        </span>

                        <span class="info-box-number"
                              id="lichBiTuChoi">
                            0
                        </span>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-6">
                <div class="info-box">
                    <span class="info-box-icon bg-secondary">
                        <i class="fas fa-paw"></i>
                    </span>

                    <div class="info-box-content">
                        <span class="info-box-text">
                            Thú cưng
                        </span>

                        <span class="info-box-number"
                              id="tongThuCung">
                            0
                        </span>
                    </div>
                </div>
            </div>

        </div>

        <!-- ========================= -->
        <!-- BIỂU ĐỒ -->
        <!-- ========================= -->

        <div class="row">

            <!-- DOANH THU THEO NGÀY -->

            <div class="col-md-6">

                <div class="card shadow-sm">

                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-line text-primary mr-2"></i>
                            Doanh thu theo ngày
                        </h3>
                    </div>

                    <div class="card-body"
                         style="height:350px;">

                        <canvas id="doanhThuChart"></canvas>

                    </div>

                </div>

            </div>

            <!-- DOANH THU THEO DỊCH VỤ -->

            <div class="col-md-6">

                <div class="card shadow-sm">

                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fas fa-chart-pie text-success mr-2"></i>
                            Doanh thu theo dịch vụ
                        </h3>
                    </div>

                    <div class="card-body"
                         style="height:350px;">

                        <canvas id="dichVuChart"></canvas>

                    </div>

                </div>

            </div>

        </div>

        <!-- ========================= -->
        <!-- BẢNG DOANH THU DỊCH VỤ -->
        <!-- ========================= -->

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white border-bottom">

                <h3 class="card-title font-weight-bold mb-0">

                    <i class="fas fa-list-ul text-primary mr-2"></i>

                    Chi tiết doanh thu dịch vụ

                </h3>

            </div>

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover mb-0">

                        <thead class="bg-light">

                            <tr>

                                <th class="text-center"
                                    style="width:70px">
                                    STT
                                </th>

                                <th>
                                    Dịch vụ
                                </th>

                                <th class="text-center"
                                    style="width:150px">
                                    Số lượng
                                </th>

                                <th class="text-right"
                                    style="width:200px">
                                    Doanh thu
                                </th>

                            </tr>

                        </thead>

                        <tbody id="baoCaoDichVuBody">
                        </tbody>

                        <tfoot class="bg-light font-weight-bold">

                            <tr>

                                <td colspan="2"
                                    class="text-right">
                                    Tổng cộng
                                </td>

                                <td id="tongSoLuongDichVu"
                                    class="text-center">
                                    0
                                </td>

                                <td id="tongDoanhThuDichVu"
                                    class="text-right">
                                    0 ₫
                                </td>

                            </tr>

                        </tfoot>

                    </table>

                </div>

            </div>

        </div>

    </div>
</section>