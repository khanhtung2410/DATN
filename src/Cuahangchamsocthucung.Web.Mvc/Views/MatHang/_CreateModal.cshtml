@using Cuahangchamsocthucung.Web.Models.Common.Modals
@model Cuahangchamsocthucung.Web.Models.MatHang.MatHangListViewModel
@{
    Layout = null;
}
<div class="modal fade" id="MatHangCreateModal" tabindex="-1" role="dialog" aria-labelledby="MatHangCreateModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            @await Html.PartialAsync("~/Views/Shared/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel("Thêm m?t hàng"))
            <form name="MatHangCreateForm" role="form" class="form-horizontal">
                <div class="modal-body">
                    <div class="form-group row required">
                        <label class="col-md-3 col-form-label">Tên</label>
                        <div class="col-md-9">
                            <input type="text" name="Ten" class="form-control" required />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">Mô t?</label>
                        <div class="col-md-9">
                            <textarea name="Mota" class="form-control"></textarea>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">Giá</label>
                        <div class="col-md-9">
                            <input type="number" name="Gia" class="form-control" step="0.01" />
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-md-3 col-form-label">Tr?ng thái</label>
                        <div class="col-md-9">
                            <input type="checkbox" name="Trangthai" value="true" checked />
                        </div>
                    </div>
                </div>
                @await Html.PartialAsync("~/Views/Shared/Modals/_ModalFooterWithSaveAndCancel.cshtml")
            </form>
        </div>
    </div>
</div>
