@model Cuahangchamsocthucung.Web.Models.MatHang.MatHangListViewModel
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Danh sách mặt hàng";
    ViewBag.CurrentPageName = "Mặt hàng";
}
<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Mặt hàng</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="javascript:;" data-toggle="modal" data-target="#CreateModal" class="btn bg-blue">
                    <i class="fa fa-plus-square"></i> Thêm
                </a>
            </div>
        </div>
    </div>
</section>
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col-md-6">
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="MatHangTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Tên</th>
                                        <th>Mô tả</th>
                                        <th>Số lượng</th>
                                        <th>Trạng thái</th>
                                        <th style="width: 200px">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model?.MatHangs != null)
                                    {
                                        foreach (var item in Model.MatHangs)
                                        {
                                            <tr>
                                                <td></td>
                                                <td>@item.Tenmathang</td>
                                                <td>@item.Mota</td>
                                                <td>@item.Soluong</td>
                                                <td>@(item.Trangthai ? "Hoạt động" : "Ngưng")</td>
                                                <td>
                                                    <button class="btn btn-sm btn-secondary edit-mathang" data-id="@item.Id" data-toggle="modal" data-target="#MatHangEditModal">Sửa</button>
                                                    <button class="btn btn-sm btn-warning toggle-status" data-id="@item.Id" data-status="@item.Trangthai">@(item.Trangthai ? "Ngưng" : "Kích hoạt")</button>
                                                    <button class="btn btn-sm btn-danger delete-mathang" data-id="@item.Id">Xóa</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
@section Scripts {

}

@await Html.PartialAsync("~/Views/MatHang/_CreateModal.cshtml", Model)

<div class="modal fade" id="MatHangEditModal" tabindex="-1" role="dialog" aria-labelledby="MatHangEditModalLabel" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
        </div>
    </div>
</div>
