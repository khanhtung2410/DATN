@model Cuahangchamsocthucung.Web.Models.MatHang.MatHangListViewModel
@using System.Security.Claims

@{
    var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    ViewBag.Title = "Danh sách mặt hàng";
    ViewBag.CurrentPageName = "Mặt hàng";
}

<section class="content-header">
    <div class="container-fluid"><div class="row"><div class="col-sm-6"><h1>Mặt hàng</h1></div><div class="col-sm-6 text-right"><a href="javascript:;" data-toggle="modal" data-target="#MatHangCreateModal" class="btn bg-blue"><i class="fa fa-plus-square"></i> Thêm</a></div></div></div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="MatHangTable" class="table table-striped table-bordered">
                                <thead><tr><th></th><th>Tên</th><th>Mô tả</th><th>Số lượng</th><th>Trạng thái</th><th style="width:280px">Hành động</th></tr></thead>
                                <tbody>
                                    @if (Model?.MatHangs != null)
                                    {
                                        foreach (var item in Model.MatHangs)
                                        {
                                            <tr>
                                                <td></td>
                                                <td>@item.Tenmathang</td>
                                                <td>@item.Mota</td>
                                                <td>@item.Soluong</td>
                                                <td>@(item.Trangthai ? "Hoạt động" : "Ngưng")</td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-info xem-mathang" data-id="@item.Id"><i class="fa fa-eye"></i> Xem</button>
                                                    <button type="button" class="btn btn-sm btn-secondary edit-mathang" data-id="@item.Id"><i class="fa fa-edit"></i> Sửa</button>
                                                    <button type="button" class="btn btn-sm @(item.Trangthai ? "btn-warning" : "btn-success") toggle-status" data-id="@item.Id" data-status="@item.Trangthai">@(item.Trangthai ? "Ngưng" : "Kích hoạt")</button>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/MatHang/_CreateModal.cshtml", Model)
<div class="modal fade" id="MatHangEditModal" tabindex="-1" role="dialog" data-backdrop="static">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content"></div>
    </div>
</div>

<!-- MODAL CHI TIẾT -->
<div class="modal fade" id="MatHangDetailModal" tabindex="-1" role="dialog" aria-labelledby="MatHangDetailModalLabel">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="MatHangDetailModalLabel"><i class="fa fa-cube"></i> Chi tiết mặt hàng</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div id="MatHangDetailLoading" class="text-center p-4"><i class="fa fa-spinner fa-spin"></i> Đang tải...</div>
                <div id="MatHangDetailContent" style="display:none;">
                    <div class="row">
                        <div class="col-md-6"><div class="form-group"><label>Tên mặt hàng</label><input type="text" id="DetailTenmathang" class="form-control" readonly /></div></div>
                    </div>
                    <div class="row">
                        <div class="col-md-6"><div class="form-group"><label>Số lượng</label><input type="text" id="DetailSoluong" class="form-control" readonly /></div></div>
                        <div class="col-md-6"><div class="form-group"><label>Trạng thái</label><div id="DetailTrangthai" class="pt-2"></div></div></div>
                    </div>
                    <div class="form-group"><label>Mô tả</label><textarea id="DetailMota" class="form-control" rows="4" readonly></textarea></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var _matHangService = abp.services.app.matHang;

            // THÊM
            $(document).on('submit', 'form[name="MatHangCreateForm"]', function (e) {
                e.preventDefault();
                var form = $(this);
                var input = {
                    tenmathang: form.find('[name="Tenmathang"]').val().trim(),
                    mota: form.find('[name="Mota"]').val().trim(),
                    soluong: parseInt(form.find('[name="Soluong"]').val(), 10) || 0,
                    trangthai: form.find('[name="Trangthai"]').is(':checked')
                };

                if (!input.tenmathang) return abp.message.warn('Vui lòng nhập tên mặt hàng.');
                if (input.soluong < 0) return abp.message.warn('Số lượng không được âm.');

                abp.ui.setBusy($('#MatHangCreateModal'));
                _matHangService.themMatHang(input).done(function () {
                    abp.notify.success('Thêm mặt hàng thành công.');
                    $('#MatHangCreateModal').modal('hide');
                    setTimeout(function () { location.reload(); }, 500);
                }).fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể thêm mặt hàng.'));
                }).always(function () {
                    abp.ui.clearBusy($('#MatHangCreateModal'));
                });
            });

            // XEM CHI TIẾT
            $(document).on('click', '.xem-mathang', function () {
                var id = parseInt($(this).data('id'), 10);

                $('#MatHangDetailLoading').show();
                $('#MatHangDetailContent').hide();
                $('#MatHangDetailModal').modal('show');

                _matHangService.layChiTietMatHang(id).done(function (data) {
                    $('#DetailTenmathang').val(data.tenmathang || '');
                    $('#DetailSoluong').val(data.soluong != null ? data.soluong : 0);
                    $('#DetailMota').val(data.mota || '');

                    $('#DetailTrangthai').html(data.trangthai
                        ? '<span class="badge badge-success"><i class="fa fa-check mr-1"></i>Hoạt động</span>'
                        : '<span class="badge badge-secondary"><i class="fa fa-times mr-1"></i>Ngưng</span>');

                    $('#MatHangDetailLoading').hide();
                    $('#MatHangDetailContent').show();
                }).fail(function (error) {
                    $('#MatHangDetailModal').modal('hide');
                    abp.message.error(getErrorMessage(error, 'Không thể tải thông tin mặt hàng.'));
                });
            });

            // MỞ MODAL SỬA
                    $(document).on('click', '.edit-mathang', function () {
            var id = parseInt($(this).data('id'), 10);
            var modal = $('#MatHangEditModal');

            modal.find('.modal-content').html('<div class="modal-body text-center p-5"><i class="fa fa-spinner fa-spin"></i><div class="mt-2">Đang tải...</div></div>');
            modal.modal('show');

            modal.find('.modal-content').load('@Url.Action("EditModal", "MatHang")?id=' + id);
        });

            // SỬA
            $(document).on('submit', 'form[name="MatHangEditForm"]', function (e) {
                e.preventDefault();
                var form = $(this);
                var input = {
                    id: parseInt(form.find('[name="Id"]').val(), 10),
                    tenmathang: form.find('[name="Tenmathang"]').val().trim(),
                    mota: form.find('[name="Mota"]').val().trim(),
                    soluong: parseInt(form.find('[name="Soluong"]').val(), 10) || 0,
                    trangthai: form.find('[name="Trangthai"]').is(':checked')
                };

                if (!input.tenmathang) return abp.message.warn('Vui lòng nhập tên mặt hàng.');
                if (input.soluong < 0) return abp.message.warn('Số lượng không được âm.');

                abp.ui.setBusy($('#MatHangEditModal'));
                _matHangService.suaMatHang(input).done(function () {
                    abp.notify.success('Cập nhật mặt hàng thành công.');
                    $('#MatHangEditModal').modal('hide');
                    setTimeout(function () { location.reload(); }, 500);
                }).fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể cập nhật mặt hàng.'));
                }).always(function () {
                    abp.ui.clearBusy($('#MatHangEditModal'));
                });
            });

            // NGƯNG / KÍCH HOẠT
            $(document).on('click', '.toggle-status', function () {
                var button = $(this);
                var id = parseInt(button.data('id'), 10);
                var currentStatus = String(button.data('status')).toLowerCase() === 'true';
                var newStatus = !currentStatus;
                var message = newStatus ? 'Bạn có muốn kích hoạt mặt hàng này?' : 'Bạn có muốn ngưng mặt hàng này?';

                abp.message.confirm(message, 'Xác nhận', function (confirmed) {
                    if (!confirmed) return;

                    _matHangService.suaTrangThaiMatHang({ id: id, trangthai: newStatus })
                        .done(function () {
                            abp.notify.success(newStatus ? 'Đã kích hoạt mặt hàng.' : 'Đã ngưng mặt hàng.');
                            setTimeout(function () { location.reload(); }, 500);
                        })
                        .fail(function (error) {
                            abp.message.error(getErrorMessage(error, 'Không thể thay đổi trạng thái mặt hàng.'));
                        });
                });
            });

            // FORMAT TIỀN
            function formatTien(value) {
                return Number(value || 0).toLocaleString('vi-VN') + ' ₫';
            }

            // XỬ LÝ LỖI
            function getErrorMessage(error, defaultMessage) {
                if (error && error.responseJSON && error.responseJSON.error)
                    return error.responseJSON.error.message || error.responseJSON.error.details || defaultMessage;
                if (error && error.error)
                    return error.error.message || error.error.details || defaultMessage;
                if (error && error.message)
                    return error.message;
                return defaultMessage;
            }
        });
    </script>
}
