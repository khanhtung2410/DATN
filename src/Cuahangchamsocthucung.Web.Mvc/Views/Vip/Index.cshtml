@using Cuahangchamsocthucung.Vip.Dto
@model List<VipDto>
@{
    ViewBag.Title = "Quản lý VIP";
    ViewBag.CurrentPageName = "VIP";
}

<section class="content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h1>Quản lý VIP</h1>
            </div>
            <div class="col-sm-6 text-right">
                <a href="javascript:;" data-toggle="modal" data-target="#ThemVipModal" class="btn bg-blue">
                    <i class="fa fa-plus-square"></i> Thêm VIP
                </a>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Danh sách cấp VIP</h3>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table id="VipTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Cấp</th>
                                        <th>Tên VIP</th>
                                        <th style="width:280px">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td><span class="badge badge-warning">VIP @item.CapVip</span></td>
                                            <td>@item.TenVip</td>
                                            <td>
                                                <button type="button" class="btn btn-sm btn-info btn-cau-hinh" data-id="@item.Id" data-name="@item.TenVip">
                                                    Cấu hình giảm giá
                                                </button>
                                                <button type="button" class="btn btn-sm btn-secondary btn-sua" data-id="@item.Id">
                                                    Sửa
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger btn-xoa" data-id="@item.Id">
                                                    Xóa
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title" id="tieuDeCauHinh">Chọn một cấp VIP để xem cấu hình</h3>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <button type="button" class="btn bg-blue" id="btnThemCauHinh" disabled>
                                <i class="fa fa-plus-square"></i> Thêm chính sách
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th>Giảm giá</th>
                                        <th>Từ ngày</th>
                                        <th>Đến ngày</th>
                                        <th style="width:120px">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody id="cauHinhBody">
                                    <tr>
                                        <td colspan="4" class="text-center text-muted">Chưa chọn cấp VIP.</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade" id="ThemVipModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm cấp VIP</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Cấp VIP</label>
                    <input type="number" id="ThemCapVip" class="form-control" min="1" max="5" />
                </div>
                <div class="form-group">
                    <label>Tên VIP</label>
                    <input type="text" id="ThemTenVip" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn bg-blue" id="btnThemVip">Thêm</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="SuaVipModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Sửa cấp VIP</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="SuaVipId" />
                <div class="form-group">
                    <label>Cấp VIP</label>
                    <input type="number" id="SuaCapVip" class="form-control" min="1" max="5" />
                </div>
                <div class="form-group">
                    <label>Tên VIP</label>
                    <input type="text" id="SuaTenVip" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn bg-blue" id="btnSuaVip">Lưu</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="CauHinhModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm chính sách giảm giá</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Phần trăm giảm (%)</label>
                    <input type="number" id="CauHinhPhanTram" class="form-control" min="0" max="100" step="0.01" />
                </div>
                <div class="form-group">
                    <label>Từ ngày</label>
                    <input type="date" id="CauHinhTuNgay" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Đến ngày</label>
                    <input type="date" id="CauHinhDenNgay" class="form-control" />
                    <small class="text-muted">Để trống nếu không có ngày kết thúc.</small>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
                <button type="button" class="btn bg-blue" id="btnLuuCauHinh">Lưu</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var service = abp.services.app.vip;
            var selectedVipId = 0;

            $('#btnThemVip').click(function () {
                var capVip = parseInt($('#ThemCapVip').val(), 10);
                var tenVip = $('#ThemTenVip').val().trim();
                if (!capVip || capVip < 1 || capVip > 5) {
                    abp.message.warn('Cấp VIP phải từ 1 đến 5.');
                    return;
                }
                if (!tenVip) {
                    abp.message.warn('Vui lòng nhập tên VIP.');
                    return;
                }
                service.themVip({ capVip: capVip, tenVip: tenVip }).done(function () {
                    abp.notify.success('Thêm cấp VIP thành công.');
                    location.reload();
                }).fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể thêm cấp VIP.'));
                });
            });

            $('.btn-sua').click(function () {
                var id = parseInt($(this).data('id'), 10);
                service.get(id).done(function (data) {
                    $('#SuaVipId').val(data.id);
                    $('#SuaCapVip').val(data.capVip);
                    $('#SuaTenVip').val(data.tenVip);
                    $('#SuaVipModal').modal('show');
                }).fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể tải thông tin VIP.'));
                });
            });

            $('#btnSuaVip').click(function () {
                var id = parseInt($('#SuaVipId').val(), 10);
                var capVip = parseInt($('#SuaCapVip').val(), 10);
                var tenVip = $('#SuaTenVip').val().trim();
                if (!capVip || capVip < 1 || capVip > 5) {
                    abp.message.warn('Cấp VIP phải từ 1 đến 5.');
                    return;
                }
                if (!tenVip) {
                    abp.message.warn('Vui lòng nhập tên VIP.');
                    return;
                }
                service.suaVip({ id: id, capVip: capVip, tenVip: tenVip }).done(function () {
                    $('#SuaVipModal').modal('hide');
                    abp.notify.success('Cập nhật VIP thành công.');
                    location.reload();
                }).fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể cập nhật VIP.'));
                });
            });

            $('.btn-xoa').click(function () {
                var id = parseInt($(this).data('id'), 10);
                abp.message.confirm('Bạn có chắc muốn xóa cấp VIP này?', 'Xác nhận', function (ok) {
                    if (!ok) return;
                    service.xoaVip(id).done(function () {
                        abp.notify.success('Xóa cấp VIP thành công.');
                        location.reload();
                    }).fail(function (error) {
                        abp.message.error(getErrorMessage(error, 'Không thể xóa VIP.'));
                    });
                });
            });

            $('.btn-cau-hinh').click(function () {
                selectedVipId = parseInt($(this).data('id'), 10);
                var name = $(this).data('name');
                $('#tieuDeCauHinh').text('Cấu hình giảm giá - ' + name);
                $('#btnThemCauHinh').prop('disabled', false);
                loadCauHinh();
            });

            $('#btnThemCauHinh').click(function () {
                $('#CauHinhPhanTram').val('');
                $('#CauHinhTuNgay').val('');
                $('#CauHinhDenNgay').val('');
                $('#CauHinhModal').modal('show');
            });

            $('#btnLuuCauHinh').click(function () {
                var phanTram = parseFloat($('#CauHinhPhanTram').val());
                var tuNgay = $('#CauHinhTuNgay').val();
                var denNgay = $('#CauHinhDenNgay').val();
                if (isNaN(phanTram) || phanTram < 0 || phanTram > 100) {
                    abp.message.warn('Phần trăm giảm phải từ 0 đến 100.');
                    return;
                }
                if (!tuNgay) {
                    abp.message.warn('Vui lòng chọn ngày bắt đầu.');
                    return;
                }
                if (denNgay && denNgay < tuNgay) {
                    abp.message.warn('Ngày kết thúc không được nhỏ hơn ngày bắt đầu.');
                    return;
                }
                service.themCauHinhVip({
                    vipId: selectedVipId,
                    phanTramGiam: phanTram,
                    tuNgay: tuNgay,
                    denNgay: denNgay || null
                }).done(function () {
                    $('#CauHinhModal').modal('hide');
                    abp.notify.success('Thêm chính sách thành công.');
                    loadCauHinh();
                }).fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể thêm chính sách.'));
                });
            });

            function loadCauHinh() {
                if (!selectedVipId) return;
                service.layCauHinhVip(selectedVipId).done(function (data) {
                    var html = '';
                    if (!data || data.length === 0) {
                        html = '<tr><td colspan="4" class="text-center text-muted">Chưa có chính sách.</td></tr>';
                    } else {
                        data.forEach(function (item) {
                            var tuNgay = new Date(item.tuNgay).toLocaleDateString('vi-VN');
                            var denNgay = item.denNgay ? new Date(item.denNgay).toLocaleDateString('vi-VN') : 'Không giới hạn';
                            html += '<tr><td><strong>' + item.phanTramGiam + '%</strong></td><td>' + tuNgay + '</td><td>' + denNgay + '</td><td><button class="btn btn-sm btn-danger btn-xoa-cauhinh" data-id="' + item.id + '">Xóa</button></td></tr>';
                        });
                    }
                    $('#cauHinhBody').html(html);
                    $('.btn-xoa-cauhinh').click(function () {
                        var id = parseInt($(this).data('id'), 10);
                        abp.message.confirm('Bạn có chắc muốn xóa chính sách này?', 'Xác nhận', function (ok) {
                            if (!ok) return;
                            service.xoaCauHinhVip(id).done(function () {
                                abp.notify.success('Xóa chính sách thành công.');
                                loadCauHinh();
                            }).fail(function (error) {
                                abp.message.error(getErrorMessage(error, 'Không thể xóa chính sách.'));
                            });
                        });
                    });
                }).fail(function (error) {
                    abp.message.error(getErrorMessage(error, 'Không thể tải cấu hình VIP.'));
                });
            }

            function getErrorMessage(error, defaultMessage) {
                if (error && error.responseJSON && error.responseJSON.error) {
                    return error.responseJSON.error.message || error.responseJSON.error.details || defaultMessage;
                }
                if (error && error.error) return error.error.message || error.error.details || defaultMessage;
                if (error && error.message) return error.message;
                return defaultMessage;
            }
        });
    </script>
}