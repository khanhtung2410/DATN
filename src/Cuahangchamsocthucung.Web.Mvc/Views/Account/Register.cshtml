@using Cuahangchamsocthucung.KhachHang.Dto
@model DangKyDto

@{
    ViewData["Title"] = "Đăng ký";
}

<h2>Đăng ký</h2>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage as string))
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

@if (!string.IsNullOrEmpty(TempData["SuccessMessage"] as string))
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<form asp-action="Register" method="post" novalidate>
    @Html.AntiForgeryToken()
    <div class="mb-3">
        <label for="SDT" class="form-label">Số điện thoại</label>
        <input asp-for="SDT" class="form-control" maxlength="10"  />
        <span class="text-danger" asp-validation-for="SDT"></span>
    </div>

    <div class="mb-3">
        <label for="HoTen" class="form-label">Họ và tên</label>
        <input asp-for="HoTen" class="form-control" />
        <span class="text-danger" asp-validation-for="HoTen"></span>
    </div>

    <div class="mb-3">
        <label for="Email" class="form-label">Email</label>
        <input asp-for="Email" class="form-control" />
        <span class="text-danger" asp-validation-for="Email"></span>
    </div>

    <div class="mb-3">
        <label for="MatKhau" class="form-label">Mật khẩu</label>
        <input asp-for="MatKhau" type="password" class="form-control"  />
        <span class="text-danger" asp-validation-for="MatKhau"></span>
    </div>

    <div class="mb-3">
        <label for="XacNhanMatKhau" class="form-label">Nhập lại mật khẩu</label>
        <input asp-for="XacNhanMatKhau" type="password" class="form-control"  />
        <span class="text-danger" asp-validation-for="XacNhanMatKhau"></span>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            <button type="submit" class="btn btn-primary">Đăng ký</button>
        </div>
        <div class="text-end">
            <small>Bạn đã có tài khoản? <a asp-action="Login" asp-controller="Account">Đăng nhập</a></small>
        </div>
    </div>
</form>

@section Scripts {
    @* <partial name="_ValidationScriptsPartial" /> *@
}