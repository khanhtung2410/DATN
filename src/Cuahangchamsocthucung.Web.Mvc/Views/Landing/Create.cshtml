@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Đặt lịch chăm sóc";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <span class="text-warning fw-bold">ĐẶT LỊCH CHĂM SÓC</span>
        <h1 class="fw-bold mt-2">Đặt lịch cho thú cưng</h1>
        <p class="text-muted">Vui lòng lựa chọn thú cưng, dịch vụ và thời gian bạn mong muốn.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">
                    <form id="DatLichForm">

                        <!-- THÚ CƯNG -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Thú cưng <span class="text-danger">*</span>
                            </label>
                            <select id="ThuCungId" class="form-select" required>
                                <option value="">-- Đang tải thú cưng --</option>
                            </select>
                        </div>

                        <!-- DỊCH VỤ -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Dịch vụ <span class="text-danger">*</span>
                            </label>
                            <select id="DichVuId" class="form-select" required>
                                <option value="">-- Đang tải dịch vụ --</option>
                            </select>
                        </div>

                        <!-- BẢNG GIÁ -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Bảng giá <span class="text-danger">*</span>
                            </label>
                            <select id="BangGiaId" class="form-select" required disabled>
                                <option value="">-- Chọn dịch vụ trước --</option>
                            </select>
                        </div>

                        <!-- THỜI GIAN -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                Ngày và giờ <span class="text-danger">*</span>
                            </label>
                            <input type="datetime-local" id="ThoiGian" class="form-control" required />
                            <small class="text-muted">Vui lòng chọn thời gian trong tương lai.</small>
                        </div>

                        <!-- ĐIỀU KHOẢN -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input type="checkbox" id="DongYDieuKhoan" class="form-check-input" required />
                                <label class="form-check-label" for="DongYDieuKhoan">
                                    Tôi đã đọc và đồng ý với
                                    <a href="#" data-bs-toggle="modal" data-bs-target="#DieuKhoanModal">
                                        điều khoản sử dụng dịch vụ
                                    </a>
                                </label>
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <strong>Lưu ý:</strong>
                            Lịch sau khi đặt sẽ ở trạng thái <strong>Chờ xác nhận</strong>.
                            Cửa hàng sẽ xác nhận và phân công nhân viên sau đó.
                        </div>

                        <!-- BUTTON -->
                        <div class="text-center mt-4">
                            <a asp-controller="Landing" asp-action="Index"
                               class="btn btn-outline-secondary rounded-pill px-4">
                                Quay lại
                            </a>

                            <button type="submit" id="btnDatLich"
                                    class="btn btn-warning rounded-pill px-5">
                                <span id="btnText">Đặt lịch</span>
                                <span id="btnLoading"
                                      class="spinner-border spinner-border-sm d-none"
                                      role="status"></span>
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL ĐIỀU KHOẢN -->
<div class="modal fade" id="DieuKhoanModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title fw-bold">Điều khoản sử dụng dịch vụ</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <h6 class="fw-bold">1. Điều kiện sử dụng dịch vụ</h6>
                <p>Khách hàng cần cung cấp thông tin chính xác về thú cưng và tình trạng sức khỏe của thú cưng trước khi sử dụng dịch vụ.</p>

                <h6 class="fw-bold">2. Tình trạng sức khỏe</h6>
                <p>Khách hàng có trách nhiệm thông báo cho cửa hàng về bệnh lý, dị ứng hoặc các tình trạng đặc biệt của thú cưng.</p>

                <h6 class="fw-bold">3. Dịch vụ tiêm phòng</h6>
                <p>Thú cưng sử dụng dịch vụ tiêm phòng cần có tình trạng sức khỏe phù hợp và không thuộc trường hợp chống chỉ định của vaccine.</p>

                <h6 class="fw-bold">4. Quyền từ chối dịch vụ</h6>
                <p>Cửa hàng có quyền từ chối hoặc thay đổi dịch vụ nếu thú cưng có dấu hiệu bệnh, quá hung dữ hoặc không đảm bảo an toàn.</p>

                <h6 class="fw-bold">5. Trường hợp thú cưng tử vong</h6>
                <p>Trong trường hợp thú cưng tử vong, cửa hàng và khách hàng sẽ phối hợp xác định nguyên nhân và trách nhiệm dựa trên tình trạng thực tế và quá trình cung cấp dịch vụ.</p>

                <h6 class="fw-bold">6. Hủy lịch</h6>
                <p>Khách hàng cần thông báo cho cửa hàng khi muốn hủy hoặc thay đổi lịch đã đặt.</p>

                <h6 class="fw-bold">7. Xác nhận lịch</h6>
                <p>Lịch đặt trên hệ thống ở trạng thái <strong>Chờ xác nhận</strong> và chỉ chính thức sau khi cửa hàng xác nhận.</p>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-warning rounded-pill px-4"
                        data-bs-dismiss="modal">
                    Đã đọc
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            console.log("=== TRANG ĐẶT LỊCH ===");

            loadThuCungs();
            loadDichVus();
            setMinDate();

            // =========================
            // MIN DATE
            // =========================
            function setMinDate() {
                var now = new Date();
                now.setMinutes(now.getMinutes() - now.getTimezoneOffset());

                $('#ThoiGian').attr(
                    'min',
                    now.toISOString().slice(0, 16)
                );
            }

            // =========================
            // LOAD THÚ CƯNG
            // =========================
            function loadThuCungs() {
                var select = $('#ThuCungId');
                select.html('<option value="">-- Đang tải thú cưng... --</option>');

                abp.services.app.thuCung.getCuaToi()
                    .done(function (result) {
                        console.log("Dữ liệu Thú cưng:", result);

                        select.empty();
                        select.append('<option value="">-- Chọn thú cưng --</option>');

                        var list = Array.isArray(result)
                            ? result
                            : (result.items || []);

                        if (list.length === 0) {
                            select.append(
                                '<option value="" disabled>(Bạn chưa có thú cưng nào)</option>'
                            );
                            return;
                        }

                        $.each(list, function (index, item) {
                            select.append(
                                $('<option>', {
                                    value: item.id,
                                    text: item.tenThuCung ||
                                          item.tenThucung ||
                                          item.tenthucung ||
                                          item.name ||
                                          'Thú cưng'
                                })
                            );
                        });
                    })
                    .fail(function (error) {
                        console.error("Lỗi load thú cưng:", error);
                        showError(
                            getErrorMessage(
                                error,
                                'Không thể tải danh sách thú cưng.'
                            )
                        );
                    });
            }

            // =========================
            // LOAD DỊCH VỤ
            // =========================
            function loadDichVus() {
                var select = $('#DichVuId');
                select.html('<option value="">-- Đang tải dịch vụ... --</option>');

                abp.services.app.dichVu.getAll()
                    .done(function (result) {
                        console.log("Dữ liệu Dịch vụ:", result);

                        select.empty();
                        select.append('<option value="">-- Chọn dịch vụ --</option>');

                        var list = Array.isArray(result)
                            ? result
                            : (result.items || []);

                        $.each(list, function (index, item) {
                            var trangThai =
                                item.trangthai !== undefined
                                    ? item.trangthai
                                    : item.trangThai;

                            var ten =
                                item.tendichvu ||
                                item.tenDichVu ||
                                item.name ||
                                'Dịch vụ';

                            if (trangThai === true) {
                                select.append(
                                    $('<option>', {
                                        value: item.id,
                                        text: ten
                                    })
                                );
                            }
                        });

                        if (select.find('option').length <= 1) {
                            select.append(
                                '<option value="" disabled>' +
                                '(Hiện không có dịch vụ hoạt động)' +
                                '</option>'
                            );
                        }
                    })
                    .fail(function (error) {
                        console.error("Lỗi load dịch vụ:", error);
                        showError(
                            getErrorMessage(
                                error,
                                'Không thể tải danh sách dịch vụ.'
                            )
                        );
                    });
            }

            // =========================
            // CHỌN DỊCH VỤ
            // =========================
            $('#DichVuId').on('change', function () {
                var dichVuId = parseInt($(this).val(), 10);
                var select = $('#BangGiaId');

                select.empty();
                select.append('<option value="">-- Chọn bảng giá --</option>');
                select.prop('disabled', true);

                if (!dichVuId) {
                    return;
                }

                console.log("Đang lấy dịch vụ:", dichVuId);

                abp.services.app.dichVu.getDichVu(dichVuId)
                    .done(function (result) {
                        console.log("Chi tiết dịch vụ:", result);

                        var list =
                            result.bangGias ||
                            result.bangGiaList ||
                            [];

                        if (list.length === 0) {
                            select.append(
                                '<option value="" disabled>' +
                                '(Dịch vụ chưa có bảng giá)' +
                                '</option>'
                            );
                            return;
                        }

                        $.each(list, function (index, item) {
                            var loaiThuCung =
                                item.loaithucung ||
                                item.loaiThuCung ||
                                '';

                            var canNangTu =
                                item.cannangtu !== undefined
                                    ? item.cannangtu
                                    : item.canNangTu;

                            var canNangDen =
                                item.cannangden !== undefined
                                    ? item.cannangden
                                    : item.canNangDen;

                            var loaiLong =
                                item.loailong !== undefined
                                    ? item.loailong
                                    : item.loaiLong;

                            var gia =
                                item.giadv !== undefined
                                    ? item.giadv
                                    : item.giaDv;

                            var text = loaiThuCung || 'Bảng giá';

                            if (canNangTu !== undefined && canNangDen !== undefined) {
                                text += ' - ' + canNangTu + ' đến ' + canNangDen + ' kg';
                            }

                            if (loaiLong === true) {
                                text += ' - Lông dài';
                            }
                            else if (loaiLong === false) {
                                text += ' - Lông ngắn';
                            }

                            if (gia !== undefined && gia !== null) {
                                text += ' - ' +
                                    Number(gia).toLocaleString('vi-VN') +
                                    ' VNĐ';
                            }

                            select.append(
                                $('<option>', {
                                    value: item.id,
                                    text: text
                                })
                            );
                        });

                        select.prop('disabled', false);
                    })
                    .fail(function (error) {
                        console.error("Lỗi load bảng giá:", error);
                        showError(
                            getErrorMessage(
                                error,
                                'Không thể tải bảng giá.'
                            )
                        );
                    });
            });

            // =========================
            // SUBMIT ĐẶT LỊCH
            // =========================
            $('#DatLichForm').on('submit', function (e) {
                e.preventDefault();

                var thuCungId = parseInt($('#ThuCungId').val(), 10);
                var dichVuId = parseInt($('#DichVuId').val(), 10);
                var bangGiaId = parseInt($('#BangGiaId').val(), 10);
                var thoiGian = $('#ThoiGian').val();

                console.log("=== BẮT ĐẦU ĐẶT LỊCH ===");

                // VALIDATION
                if (!thuCungId) {
                    showWarning('Vui lòng chọn thú cưng.');
                    return;
                }

                if (!dichVuId) {
                    showWarning('Vui lòng chọn dịch vụ.');
                    return;
                }

                if (!bangGiaId) {
                    showWarning('Vui lòng chọn bảng giá.');
                    return;
                }

                if (!thoiGian) {
                    showWarning('Vui lòng chọn ngày và giờ.');
                    return;
                }

                if (!$('#DongYDieuKhoan').is(':checked')) {
                    showWarning('Vui lòng đồng ý với điều khoản sử dụng dịch vụ.');
                    return;
                }

                // KIỂM TRA THỜI GIAN
                var selectedDate = new Date(thoiGian);

                if (isNaN(selectedDate.getTime())) {
                    showWarning('Thời gian không hợp lệ.');
                    return;
                }

                if (selectedDate <= new Date()) {
                    showWarning('Vui lòng chọn thời gian trong tương lai.');
                    return;
                }

                // DTO
                var input = {
                    thuCungId: thuCungId,
                    dichVuId: dichVuId,
                    bangGiaId: bangGiaId,
                    thoiGian: thoiGian
                };

                setLoading(true);

                abp.services.app.lichChamSoc.create(input)
                    .done(function (result) {
                        console.log("=== CREATE THÀNH CÔNG ===", result);

                        showSuccess('Đặt lịch chăm sóc thành công!');

                        setTimeout(function () {
                            window.location.href = '/Landing/Index';
                        }, 1200);
                    })
                    .fail(function (error) {
                        console.error("=== API CREATE LỖI ===", error);

                        var message = getErrorMessage(
                            error,
                            'Đặt lịch không thành công.'
                        );

                        showError(message);
                    })
                    .always(function () {
                        setLoading(false);
                    });
            });

            // =========================
            // LOADING
            // =========================
            function setLoading(isLoading) {
                var button = $('#btnDatLich');
                button.prop('disabled', isLoading);

                if (isLoading) {
                    $('#btnText').text('Đang xử lý...');
                    $('#btnLoading').removeClass('d-none');
                } else {
                    $('#btnText').text('Đặt lịch');
                    $('#btnLoading').addClass('d-none');
                }
            }

            // =========================
            // ERROR MESSAGE PARSER
            // =========================
            function getErrorMessage(error, defaultMessage) {
                if (error && error.responseJSON && error.responseJSON.error) {
                    var backendError = error.responseJSON.error;

                    if (backendError.message) {
                        return backendError.message;
                    }
                    if (backendError.details) {
                        return backendError.details;
                    }
                    if (backendError.validationErrors && backendError.validationErrors.length) {
                        return backendError.validationErrors
                            .map(function (x) { return x.message; })
                            .join('\n');
                    }
                }

                if (error && error.error) {
                    if (error.error.message) return error.error.message;
                    if (error.error.details) return error.error.details;
                }

                if (error && error.details) return error.details;
                if (error && error.message) return error.message;

                return defaultMessage;
            }

            // =========================
            // SUCCESS NOTIFICATION
            // =========================
            function showSuccess(message) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công',
                        text: message,
                        confirmButtonText: 'OK'
                    });
                } else {
                    alert(message);
                }
            }

            // =========================
            // WARNING NOTIFICATION
            // =========================
            function showWarning(message) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Cảnh báo',
                        text: message,
                        confirmButtonText: 'OK'
                    });
                } else {
                    alert(message);
                }
            }

            // =========================
            // ERROR NOTIFICATION
            // =========================
            function showError(message) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi',
                        text: message,
                        confirmButtonText: 'Đóng'
                    });
                } else {
                    alert(message);
                }
            }

        });
    </script>
}