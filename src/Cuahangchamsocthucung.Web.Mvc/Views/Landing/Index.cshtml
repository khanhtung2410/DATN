@{
    Layout = null;
}

@{
    ViewData["Title"] = "Cửa Hàng Chăm Sóc Thú Cưng";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        background: #fff;
    }

    .hero {
        background: linear-gradient(
            rgba(0,0,0,.35),
            rgba(0,0,0,.35)
        ),
        url('/images/banner-pet.jpg');

        background-size: cover;
        background-position: center;
        height: 600px;
        display:flex;
        align-items:center;
        color:white;
    }


    .hero h1 {
        font-size:55px;
        font-weight:700;
    }


    .btn-pet {
        background:#ff8c42;
        color:white;
        padding:12px 30px;
        border-radius:30px;
        border:none;
    }


    .section-title {
        text-align:center;
        margin:50px 0 30px;
    }


    .service-card {
        border:none;
        border-radius:20px;
        overflow:hidden;
        box-shadow:0 5px 20px #ddd;
        transition:.3s;
    }

    .service-card:hover {
        transform:translateY(-10px);
    }


    .service-card img {
        height:250px;
        object-fit:cover;
    }


    .category {
        background:#fff5ec;
        border-radius:20px;
        padding:30px;
        text-align:center;
    }


    .category img {
        width:120px;
        height:120px;
        border-radius:50%;
    }


    .product-card {
        border-radius:15px;
        border:1px solid #eee;
        padding:15px;
    }


    .product-card img {
        width:100%;
        height:200px;
        object-fit:cover;
        border-radius:15px;
    }


    .cta {
        background:#ff8c42;
        color:white;
        padding:70px;
        border-radius:30px;
    }

</style>

<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
    <div class="container">

        <a class="navbar-brand fw-bold" href="/">
            Cửa Hàng Chăm Sóc Thú Cưng
        </a>


        <div class="ms-auto">

            @if (User.Identity.IsAuthenticated)
            {
                <a class="btn btn-outline-danger rounded-pill px-4"
                   href="/Account/Logout">
                    Đăng xuất
                </a>
            }
            else
            {
                <a class="btn btn-warning rounded-pill px-4"
                   href="/Account/Login">
                    Đăng nhập
                </a>
            }

        </div>

    </div>
</nav>

<!-- HERO -->

<section class="hero">
    <div class="container">

        <h1>
            Chăm sóc thú cưng<br />
            Tận tâm mỗi ngày
        </h1>

        <p class="fs-4">
            Dịch vụ spa, tắm cắt tỉa,
            khách sạn và chăm sóc chó mèo chuyên nghiệp
        </p>

        <button class="btn-pet">
            Đặt lịch ngay
        </button>

    </div>
</section>



<!-- CATEGORY -->

<section class="container">

    <h2 class="section-title">
        Dịch vụ của chúng tôi
    </h2>


    <div class="row g-4">


        <div class="col-md-4">

            <div class="service-card">

                <img src="/images/grooming.jpg">

                <div class="p-4">

                    <h4>
                        Tắm & Cắt tỉa
                    </h4>

                    <p>
                        Làm sạch lông, vệ sinh tai,
                        tạo kiểu đẹp cho thú cưng.
                    </p>

                </div>

            </div>

        </div>




        <div class="col-md-4">

            <div class="service-card">

                <img src="/images/hotel.jpg">

                <div class="p-4">

                    <h4>
                        Khách sạn thú cưng
                    </h4>

                    <p>
                        Không gian an toàn,
                        chăm sóc 24/7.
                    </p>

                </div>

            </div>

        </div>




        <div class="col-md-4">

            <div class="service-card">

                <img src="/images/spa.jpg">

                <div class="p-4">

                    <h4>
                        Spa thú cưng
                    </h4>

                    <p>
                        Massage, chăm sóc da lông.
                    </p>

                </div>

            </div>

        </div>


    </div>

</section>

<!-- CTA -->


<section class="container my-5">

    <div class="cta text-center">

        <h2>
            Đặt lịch chăm sóc thú cưng ngay hôm nay
        </h2>

        <p>
            Đội ngũ chuyên nghiệp - Dịch vụ tận tâm
        </p>


        <button class="btn btn-light rounded-pill px-5">
            Đặt lịch
        </button>


    </div>

</section>