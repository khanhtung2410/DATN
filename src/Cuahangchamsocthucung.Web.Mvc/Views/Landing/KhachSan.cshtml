@using Cuahangchamsocthucung.Entities

@model List<BangGia>

@{
    Layout = "_LandingLayout";

    ViewData["Title"] = "Khách Sạn Thú Cưng";
}


<!-- ===================================================== -->
<!-- HERO -->
<!-- ===================================================== -->

<section class="hotel-hero">

    <div class="container">

        <div class="row">

            <div class="col-lg-7">


                <h1 class="display-4 fw-bold">

                    Khách Sạn Thú Cưng

                </h1>


                <p class="fs-4 mt-3">

                    Không gian lưu trú an toàn,
                    sạch sẽ và chăm sóc tận tâm
                    dành cho chó và mèo.

                </p>


                <a class="btn btn-warning
                          rounded-pill
                          px-5
                          py-3
                          mt-3"
                   asp-controller="Landing"
                   asp-action="Create">

                    Đặt lịch ngay

                </a>

            </div>

        </div>

    </div>

</section>



<!-- ===================================================== -->
<!-- GIỚI THIỆU -->
<!-- ===================================================== -->

<section class="container my-5">

    <div class="row align-items-center g-5">


        <!-- NỘI DUNG -->

        <div class="col-md-6">

            <span class="text-warning fw-bold">

                KHÁCH SẠN THÚ CƯNG

            </span>


            <h2 class="fw-bold mt-2 mb-4">

                Không gian lưu trú
                an toàn và thoải mái

            </h2>


            <p class="fs-5">

                Dịch vụ khách sạn thú cưng cung cấp
                không gian nghỉ ngơi phù hợp cho chó
                và mèo trong thời gian chủ nuôi đi
                công tác, du lịch hoặc không có điều
                kiện chăm sóc tại nhà.

            </p>


            <p>

                Trong thời gian lưu trú, thú cưng được
                nhân viên theo dõi, cung cấp thức ăn,
                nước uống và hỗ trợ vệ sinh, chăm sóc
                cơ bản hằng ngày.

            </p>


            <a class="btn btn-warning rounded-pill px-4"
               asp-controller="Landing"
               asp-action="Create">

                Đăng ký lưu trú

            </a>

        </div>



        <!-- HÌNH ẢNH -->

        <div class="col-md-6">

            <div class="card border-0 shadow-sm overflow-hidden">


                <img src="/img/khach-san-cho-meo1-2048x1365.jpg"
                     class="img-fluid"
                     style="width:100%; height:350px; object-fit:cover;"
                     alt="Khách sạn thú cưng" />


                <div class="card-body p-4">

                    <h4 class="fw-bold">

                        Chăm sóc mỗi ngày

                    </h4>


                    <p class="text-muted mb-0">

                        Đảm bảo thú cưng được nghỉ ngơi
                        trong môi trường sạch sẽ và
                        được quan tâm trong suốt thời
                        gian lưu trú.

                    </p>

                </div>

            </div>

        </div>


    </div>

</section>



<!-- ===================================================== -->
<!-- TIỆN ÍCH -->
<!-- ===================================================== -->

<section class="container my-5">


    <h2 class="text-center fw-bold mb-5">

        Các hoạt động chăm sóc

    </h2>


    <div class="row g-4">


        <!-- DINH DƯỠNG -->

        <div class="col-md-4">

            <div class="card
                        border-0
                        shadow-sm
                        h-100">

                <div class="card-body p-4 text-center">


                    <div class="fs-1 mb-3">

                        🍖

                    </div>


                    <h4 class="fw-bold">

                        Dinh dưỡng

                    </h4>


                    <p class="text-muted">

                        Thú cưng được cung cấp thức ăn
                        và nước uống theo lịch chăm sóc.
                        Chủ nuôi có thể cung cấp thức ăn
                        riêng nếu thú cưng có chế độ ăn
                        đặc biệt.

                    </p>

                </div>

            </div>

        </div>



        <!-- VẬN ĐỘNG -->

        <div class="col-md-4">

            <div class="card
                        border-0
                        shadow-sm
                        h-100">

                <div class="card-body p-4 text-center">


                    <div class="fs-1 mb-3">

                        🐕

                    </div>


                    <h4 class="fw-bold">

                        Vận động

                    </h4>


                    <p class="text-muted">

                        Thú cưng được vận động và vui chơi
                        phù hợp với tình trạng sức khỏe.
                        Việc tiếp xúc với các thú cưng
                        khác được kiểm soát.

                    </p>

                </div>

            </div>

        </div>



        <!-- VỆ SINH -->

        <div class="col-md-4">

            <div class="card
                        border-0
                        shadow-sm
                        h-100">

                <div class="card-body p-4 text-center">


                    <div class="fs-1 mb-3">

                        🧼

                    </div>


                    <h4 class="fw-bold">

                        Vệ sinh

                    </h4>


                    <p class="text-muted">

                        Hỗ trợ chải lông, vệ sinh mắt,
                        tai và kiểm tra tình trạng
                        da lông trong thời gian lưu trú.

                    </p>

                </div>

            </div>

        </div>


    </div>

</section>



<!-- ===================================================== -->
<!-- BẢNG GIÁ -->
<!-- ===================================================== -->

<section class="container my-5">


    <div class="text-center mb-4">


        <span class="text-warning fw-bold">

            BẢNG GIÁ

        </span>


        <h2 class="fw-bold mt-2">

            Giá dịch vụ trông giữ thú cưng

        </h2>


        <p class="text-muted">

            Bảng giá được lấy trực tiếp từ hệ thống.

        </p>

    </div>



    <div class="table-responsive shadow-sm">


        <table class="table
                      table-bordered
                      table-hover
                      text-center
                      align-middle
                      mb-0">


            <thead class="table-dark">

                <tr>

                    <th>
                        STT
                    </th>

                    <th>
                        Loại phòng
                    </th>

                    <th>
                        Cân nặng
                    </th>

                    <th>
                        Giá / ngày
                    </th>

                </tr>

            </thead>


            <tbody>


                @if (Model != null && Model.Any())
                {

                    var stt = 1;


                    foreach (var item in Model)
                    {

                        <tr>


                            <!-- STT -->

                            <td>

                                @stt

                            </td>


                            <!-- LOẠI PHÒNG -->

                            <td class="fw-semibold">

                                @item.Loaithucung

                            </td>


                            <!-- CÂN NẶNG -->

                            <td>

                                @item.Cannangtu
                                -
                                @item.Cannangden
                                kg

                            </td>


                            <!-- GIÁ -->

                            <td class="fw-bold text-warning">

                                @item.Giadv.ToString("N0") đ

                            </td>


                        </tr>


                        stt++;

                    }

                }
                else
                {

                    <tr>

                        <td colspan="4"
                            class="text-muted py-5">

                            <div class="fs-4 mb-2">

                                📋

                            </div>

                            Hiện chưa có bảng giá
                            cho dịch vụ trông giữ thú cưng.

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>


    <p class="text-muted text-center mt-3">

        * Giá được cập nhật theo bảng giá hiện tại
        của cửa hàng.

    </p>

</section>



<!-- ===================================================== -->
<!-- LƯU Ý -->
<!-- ===================================================== -->

<section class="container my-5">


    <div class="alert alert-warning border-0 shadow-sm p-4">


        <h4 class="fw-bold mb-3">

            ⚠️ Lưu ý khi gửi thú cưng

        </h4>


        <ul class="mb-0">


            <li class="mb-2">

                Nên cung cấp thông tin sức khỏe
                và lịch tiêm phòng của thú cưng.

            </li>


            <li class="mb-2">

                Mang theo thức ăn quen thuộc nếu
                thú cưng có chế độ ăn riêng.

            </li>


            <li class="mb-2">

                Thông báo cho nhân viên về các vấn đề
                sức khỏe hoặc hành vi đặc biệt.

            </li>


            <li class="mb-2">

                Thú cưng có tình trạng sức khỏe bất thường
                cần thông báo trước cho cửa hàng.

            </li>


            <li>

                Cửa hàng có quyền bố trí khu vực riêng
                hoặc từ chối tiếp nhận nếu thú cưng
                không đảm bảo điều kiện an toàn.

            </li>


        </ul>

    </div>

</section>



<!-- ===================================================== -->
<!-- FAQ -->
<!-- ===================================================== -->

<section class="container my-5">


    <div class="text-center mb-4">

        <h2 class="fw-bold">

            Câu hỏi thường gặp

        </h2>

    </div>



    <div class="accordion"
         id="hotelFaq">


        <!-- CÂU 1 -->

        <div class="accordion-item">


            <h2 class="accordion-header">


                <button class="accordion-button"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#hotelQuestion1">

                    Cần chuẩn bị gì khi gửi thú cưng?

                </button>

            </h2>


            <div id="hotelQuestion1"
                 class="accordion-collapse collapse show"
                 data-bs-parent="#hotelFaq">

                <div class="accordion-body">

                    Nên chuẩn bị thông tin tiêm phòng,
                    thức ăn quen thuộc và các vật dụng
                    cá nhân cần thiết cho thú cưng.

                </div>

            </div>

        </div>



        <!-- CÂU 2 -->

        <div class="accordion-item">


            <h2 class="accordion-header">


                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#hotelQuestion2">

                    Thú cưng có được chăm sóc hằng ngày không?

                </button>

            </h2>


            <div id="hotelQuestion2"
                 class="accordion-collapse collapse"
                 data-bs-parent="#hotelFaq">

                <div class="accordion-body">

                    Có. Thú cưng được cung cấp thức ăn,
                    nước uống và thực hiện các hoạt động
                    vệ sinh, chăm sóc cơ bản.

                </div>

            </div>

        </div>



        <!-- CÂU 3 -->

        <div class="accordion-item">


            <h2 class="accordion-header">


                <button class="accordion-button collapsed"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#hotelQuestion3">

                    Có thể đăng ký thêm dịch vụ tắm Spa không?

                </button>

            </h2>


            <div id="hotelQuestion3"
                 class="accordion-collapse collapse"
                 data-bs-parent="#hotelFaq">

                <div class="accordion-body">

                    Có. Khách hàng có thể đăng ký thêm
                    dịch vụ tắm Spa hoặc cắt tỉa lông
                    nếu có nhu cầu.

                </div>

            </div>

        </div>


    </div>

</section>



<!-- ===================================================== -->
<!-- CTA -->
<!-- ===================================================== -->

<section class="container my-5">


    <div class="cta text-center p-5">


        <h2 class="fw-bold">

            Đặt lịch lưu trú cho thú cưng

        </h2>


        <p class="fs-5 mt-3">

            Đặt lịch trước để cửa hàng chuẩn bị
            khu vực lưu trú phù hợp.

        </p>


        <a class="btn btn-light
                  rounded-pill
                  px-5
                  py-3
                  mt-2"
           asp-controller="Landing"
           asp-action="Create">

            Đặt lịch ngay

        </a>

    </div>

</section>